{
  "name": "holy-quran-roots",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-data.ts",
    "build": "next build",
    "postbuild": "tsx scripts/build-sw.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:build": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/build-data.ts --check",
    "icons:build": "tsx scripts/build-icons.ts",
    "build:ghpages": "tsx scripts/build-data.ts && NEXT_PUBLIC_BASE_PATH=/Holy-Qur-an next build && NEXT_PUBLIC_BASE_PATH=/Holy-Qur-an tsx scripts/build-sw.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
