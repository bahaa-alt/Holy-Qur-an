{"slug":"soosi","n":100,"verses":[{"a":1,"t":"وَاَلۡعَٰدِيَٰت ضَّبۡحࣰ ا"},{"a":2,"t":"فَاَلۡمُورِيَٰتِ قَدۡحࣰ ا"},{"a":3,"t":"فَاَلۡمُغِيرَٰت صُّبۡحࣰ ا"},{"a":4,"t":"فَأَثَرۡنَ بِهِۦ نَقۡعࣰ ا"},{"a":5,"t":"فَوَسَطۡنَ بِهِۦ جَمۡعًا"},{"a":6,"t":"إِنَّ اَ۬لۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ‏"},{"a":7,"t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ‏"},{"a":8,"t":"وَإِنَّهُۥ لِحُبِّ اِ۬لۡخَيۡر لَّشَدِيدٌ"},{"a":9,"t":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي اِ۬لۡقُبُورِ"},{"a":10,"t":"وَحُصِّلَ مَا فِي اِ۬لصُّدُورِ"},{"a":11,"t":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ"}]}