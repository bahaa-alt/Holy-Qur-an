{"slug":"soosi","n":92,"verses":[{"a":1,"t":"وَاَلَّيۡلِ إِذَا يَغۡشٜ يٰ"},{"a":2,"t":"وَاَلنَّه۪ارِ إِذَا تَجَلّٜ يٰ"},{"a":3,"t":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَاَلۡأُنثٜ يٰ"},{"a":4,"t":"إِنَّ سَعۡيَكُمۡ لَشَتّٜ يٰ"},{"a":5,"t":"فَأَمَّا مَنۡ أَعۡطَىٰ وَاَتَّقٜ يٰ"},{"a":6,"t":"وَصَدَّقَ بِالۡحُسۡنٜ يٰ"},{"a":7,"t":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡر۪يٰ"},{"a":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَاَسۡتَغۡنٜ يٰ"},{"a":9,"t":"وَكَذَّب بِّالۡحُسۡنٜ يٰ"},{"a":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡر۪يٰ"},{"a":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥ إِذَا تَرَدّٜ يٰ"},{"a":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدٜ يٰ"},{"a":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَاَلۡأُولٜ يٰ"},{"a":14,"t":"فَأَنذَرۡتُكُمۡ نَارࣰ ا تَلَظّٜ يٰ"},{"a":15,"t":"لَا يَصۡلَىٰهَا إِلَّا اَ۬لۡأَشۡقَى"},{"a":16,"t":"اَ۬لَّذِي كَذَّبَ وَتَوَلّٜ يٰ"},{"a":17,"t":"وَسَيُجَنَّبُهَا اَ۬لۡأَتۡقَى"},{"a":18,"t":"اَ۬لَّذِي يُوتِي مَالَهُۥ يَتَزَكّٜ يٰ"},{"a":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزٜ يٰ"},{"a":20,"t":"إِلَّا اَ۪بۡتِغَآءَ وَجۡهِ رَبِّهِ اِ۬لۡأَعۡلٜ يٰ"},{"a":21,"t":"وَلَسَوۡفَ يَرۡضٜ يٰ"}]}