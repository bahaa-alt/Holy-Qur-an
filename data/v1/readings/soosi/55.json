{"slug":"soosi","n":55,"verses":[{"a":1,"t":"اِ۬لرَّحۡمَٰنُ"},{"a":2,"t":"عَلَّمَ اَ۬لۡقُرۡءَانَ"},{"a":3,"t":"خَلَقَ اَ۬لۡإِنسَٰنَ"},{"a":4,"t":"عَلَّمَهُ اُ۬لۡبَيَانَ"},{"a":5,"t":"اَ۬لشَّمۡسُ وَاَلۡقَمَرُ بِحُسۡبَانࣲ‏"},{"a":6,"t":"وَاَلنَّجۡمُ وَاَلشَّجَرُ يَسۡجُدَانِ"},{"a":7,"t":"وَاَلسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لۡمِيزَانَ"},{"a":8,"t":"أَلَّا تَطۡغَوۡاْ فِي اِ۬لۡمِيزَانِ"},{"a":9,"t":"وَأَقِيمُواْ اُ۬لۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُواْ اُ۬لۡمِيزَانَ"},{"a":10,"t":"وَاَلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ"},{"a":11,"t":"فِيهَا فَٰكِهَةࣱ وَاَلنَّخۡلُ ذَاتُ اُ۬لۡأَكۡمَامِ"},{"a":12,"t":"وَاَلۡحَبُّ ذُو اُ۬لۡعَصۡفِ وَاَلرَّيۡحَانُ"},{"a":13,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":14,"t":"خَلَقَ اَ۬لۡإِنسَٰنَ مِن صَلۡصَٰلࣲ كَاَلۡفَخّ۪ارِ"},{"a":15,"t":"وَخَلَقَ اَ۬لۡجَآنَّ مِن مَّارِجࣲ مِّن نّ۪ارࣲ‏"},{"a":16,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":17,"t":"رَبُّ اُ۬لۡمَشۡرِقَيۡنِ وَرَبُّ اُ۬لۡمَغۡرِبَيۡنِ"},{"a":18,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":19,"t":"مَرَجَ اَ۬لۡبَحۡرَيۡنِ يَلۡتَقِيَانِ"},{"a":20,"t":"بَيۡنَهُمَا بَرۡزَخࣱ لَّا يَبۡغِيَانِ"},{"a":21,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":22,"t":"يُخۡرَجُ مِنۡهُمَا اَ۬للُّولُؤُ وَاَلۡمَرۡجَانُ"},{"a":23,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":24,"t":"وَلَهُ اُ۬لۡجَوَارِ اِ۬لۡمُنشَـَٔاتُ فِي اِ۬لۡبَحۡرِ كَاَلۡأَعۡلَٰمِ"},{"a":25,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":26,"t":"كُلُّ مَنۡ عَلَيۡهَا فَانࣲ‏"},{"a":27,"t":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو اُ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ"},{"a":28,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":29,"t":"يَسۡـَٔلُهُۥ مَن فِي اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَانࣲ‏"},{"a":30,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":31,"t":"سَنَفۡرُغُ لَكُمۡ أَيُّهَ اَ۬لثَّقَلَانِ"},{"a":32,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":33,"t":"يَٰمَعۡشَرَ اَ۬لۡجِنِّ وَاَلۡإِنسِ إِنِ اِ۪سۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡط۪ارِ اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِ فَاَنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنࣲ‏"},{"a":34,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":35,"t":"يُرۡسَلُ عَلَيۡكُمَا شُوَاظࣱ مِّن نّ۪ارࣲ وَنُحَاسࣲ فَلَا تَنتَصِرَانِ"},{"a":36,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":37,"t":"فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتۡ وَرۡدَةࣰ كَاَلدِّهَانِ"},{"a":38,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":39,"t":"فَيَوۡمَئِذࣲ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦ إِنسࣱ وَلَا جَآنࣱّ‏"},{"a":40,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":41,"t":"۞يُعۡرَفُ اُ۬لۡمُجۡرِمُونَ بِسِيمٰٜهُمۡ فَيُوخَذُ بِالنَّوَٰصِي وَاَلۡأَقۡدَامِ"},{"a":42,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":43,"t":"هَٰذِهِۦ جَهَنَّمُ اُ۬لَّتِي يُكَذِّب بِّهَا اَ۬لۡمُجۡرِمُونَ"},{"a":44,"t":"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانࣲ‏"},{"a":45,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":46,"t":"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"},{"a":47,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":48,"t":"ذَوَاتَا أَفۡنَانࣲ‏"},{"a":49,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":50,"t":"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ"},{"a":51,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":52,"t":"فِيهِمَا مِن كُلِّ فَٰكِهَةࣲ زَوۡجَانِ"},{"a":53,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":54,"t":"مُتَّكِـِٔينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقࣲۚ وَجَنَى اَ۬لۡجَنَّتَيۡنِ دَانࣲ‏"},{"a":55,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":56,"t":"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسࣱ قَبۡلَهُمۡ وَلَا جَآنࣱّ‏"},{"a":57,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":58,"t":"كَأَنَّهُنَّ اَ۬لۡيَاقُوتُ وَاَلۡمَرۡجَانُ"},{"a":59,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":60,"t":"هَلۡ جَزَآءُ اُ۬لۡإِحۡسَٰنِ إِلَّا اَ۬لۡإِحۡسَٰنُ"},{"a":61,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":62,"t":"وَمِن دُونِهِمَا جَنَّتَانِ"},{"a":63,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":64,"t":"مُدۡهَآمَّتَانِ"},{"a":65,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":66,"t":"فِيهِمَا عَيۡنَان نَّضَّاخَتَانِ"},{"a":67,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":68,"t":"فِيهِمَا فَٰكِهَةࣱ وَنَخۡلࣱ وَرُمَّانࣱ‏"},{"a":69,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":70,"t":"فِيهِنَّ خَيۡرَٰتٌ حِسَانࣱ‏"},{"a":71,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":72,"t":"۞حُورࣱ مَّقۡصُورَٰتࣱ فِي اِ۬لۡخِيَامِ"},{"a":73,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":74,"t":"لَمۡ يَطۡمِثۡهُنَّ إِنسࣱ قَبۡلَهُمۡ وَلَا جَآنࣱّ‏"},{"a":75,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":76,"t":"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرࣲ وَعَبۡقَرِيٍّ حِسَانࣲ‏"},{"a":77,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":78,"t":"تَبَٰرَكَ اَ۪سۡمُ رَبِّكَ ذِي اِ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ"}]}