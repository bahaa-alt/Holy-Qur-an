{"slug":"soosi","n":79,"verses":[{"a":1,"t":"وَاَلنَّٰزِعَٰتِ غَرۡقࣰ ا"},{"a":2,"t":"وَاَلنَّٰشِطَٰتِ نَشۡطࣰ ا"},{"a":3,"t":"وَاَلسَّٰبِحَٰت سَّبۡحࣰ ا"},{"a":4,"t":"فَاَلسَّٰبِقَٰت سَّبۡقࣰ ا"},{"a":5,"t":"فَاَلۡمُدَبِّرَٰتِ أَمۡرࣰ ا"},{"a":6,"t":"يَوۡمَ تَرۡجُفُ اُ۬لرَّاجِفَة"},{"a":7,"t":"تَّتۡبَعُهَا اَ۬لرَّادِفَةُ"},{"a":8,"t":"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ"},{"a":9,"t":"أَبۡصَٰرُهَا خَٰشِعَةࣱ‏"},{"a":10,"t":"يَقُولُونَ أَٰ۟نَّا لَمَرۡدُودُونَ فِي اِ۬لۡحَافِرَةِ"},{"a":11,"t":"أَٰ۟ذَا كُنَّا عِظَٰمࣰ ا نَّخِرَةࣰ‏"},{"a":12,"t":"قَالُواْ تِلۡكَ إِذࣰ ا كَرَّةٌ خَاسِرَةࣱ‏"},{"a":13,"t":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ‏"},{"a":14,"t":"فَإِذَا هُم بِالسَّاهِرَةِ"},{"a":15,"t":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسٜ يٰ"},{"a":16,"t":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِالۡوَادِ اِ۬لۡمُقَدَّسِ طُوَى"},{"a":17,"t":"اَ۪ذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغٜ يٰ"},{"a":18,"t":"فَقُلۡ هَل لَّكَ إِلَىٰ أَن تَزَكّٜ يٰ"},{"a":19,"t":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشٜ يٰ"},{"a":20,"t":"فَأَر۪ىٰهُ اُ۬لۡأٓيَةَ اَ۬لۡكُبۡر۪يٰ"},{"a":21,"t":"فَكَذَّبَ وَعَصٜ يٰ"},{"a":22,"t":"ثُمَّ أَدۡبَرَ يَسۡعٜ يٰ"},{"a":23,"t":"فَحَشَرَ فَنَادٜ يٰ"},{"a":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ اُ۬لۡأَعۡلٜ يٰ"},{"a":25,"t":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لۡأٓخِرَةِ وَاَلۡأُولٜ يٰ"},{"a":26,"t":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشٜ يٰ"},{"a":27,"t":"ءَٰا۬نتُمۡ أَشَدُّ خَلۡقًا أَمِ اِ۬لسَّمَآءُۚ بَنٜ ىٰهَا"},{"a":28,"t":"رَفَعَ سَمۡكَهَا فَسَوّٜ ىٰهَا"},{"a":29,"t":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحٜ ىٰهَا"},{"a":30,"t":"وَاَلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحٜ ىٰهَا"},{"a":31,"t":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعٜ ىٰهَا"},{"a":32,"t":"وَاَلۡجِبَالَ أَرۡسٜ ىٰهَا"},{"a":33,"t":"مَتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"},{"a":34,"t":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لۡكُبۡر۪يٰ"},{"a":35,"t":"يَوۡمَ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ مَا سَعٜ يٰ"},{"a":36,"t":"وَبُرِّزَتِ اِ۬لۡجَحِيمُ لِمَن يَر۪يٰ"},{"a":37,"t":"فَأَمَّا مَن طَغَىٰ"},{"a":38,"t":"وَءَاثَرَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيٜ ا"},{"a":39,"t":"فَإِنَّ اَ۬لۡجَحِيمَ هِيَ اَ۬لۡمَاوٜ يٰ"},{"a":40,"t":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفۡسَ عَنِ اِ۬لۡهَوٜ يٰ"},{"a":41,"t":"فَإِنَّ اَ۬لۡجَنَّةَ هِيَ اَ۬لۡمَاوٜ يٰ"},{"a":42,"t":"۞يَسۡـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرۡسٜ ىٰهَا"},{"a":43,"t":"فِيمَ أَنتَ مِن ذِكۡر۪ىٰهَا"},{"a":44,"t":"إِلَىٰ رَبِّكَ مُنتَهٜ ىٰهَا"},{"a":45,"t":"إِنَّمَا أَنتَ مُنذِرُ مَن يَخۡشٜ ىٰهَا"},{"a":46,"t":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُواْ إِلَّا عَشِيَّةً أَوۡ ضُحٜ ىٰهَا"}]}