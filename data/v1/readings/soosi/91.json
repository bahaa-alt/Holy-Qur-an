{"slug":"soosi","n":91,"verses":[{"a":1,"t":"وَاَلشَّمۡسِ وَضُحٜ ىٰهَا"},{"a":2,"t":"وَاَلۡقَمَرِ إِذَا تَلٜ ىٰهَا"},{"a":3,"t":"وَاَلنَّه۪ارِ إِذَا جَلّٜ ىٰهَا"},{"a":4,"t":"وَاَلَّيۡلِ إِذَا يَغۡشٜ ىٰهَا"},{"a":5,"t":"وَاَلسَّمَآءِ وَمَا بَنٜ ىٰهَا"},{"a":6,"t":"وَاَلۡأَرۡضِ وَمَا طَحٜ ىٰهَا"},{"a":7,"t":"وَنَفۡسࣲ وَمَا سَوّٜ ىٰهَا"},{"a":8,"t":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوٜ ىٰهَا"},{"a":9,"t":"قَدۡ أَفۡلَحَ مَن زَكّٜ ىٰهَا"},{"a":10,"t":"وَقَدۡ خَابَ مَن دَسّٜ ىٰهَا"},{"a":11,"t":"كَذَّبَت ثَّمُودُ بِطَغۡوٜ ىٰهَا"},{"a":12,"t":"إِذِ اِ۪نۢبَعَثَ أَشۡقٜ ىٰهَا"},{"a":13,"t":"فَقَال لَّهُمۡ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقۡيٰٜهَا"},{"a":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوّٜ ىٰهَا"},{"a":15,"t":"وَلَا يَخَافُ عُقۡبٰٜهَا"}]}