{"slug":"soosi","n":75,"verses":[{"a":1,"t":"لَا أُقۡسِم بِيَوۡمِ اِ۬لۡقِيَٰمَةِ"},{"a":2,"t":"وَلَا أُقۡسِم بِالنَّفۡسِ اِ۬للَّوَّامَةِ"},{"a":3,"t":"أَيَحۡسِبُ اُ۬لۡإِنسَٰنُ أَلَّن نَّجۡمَع عِّظَامَهُۥ"},{"a":4,"t":"بَلَىٰ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥ"},{"a":5,"t":"بَلۡ يُرِيدُ اُ۬لۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ"},{"a":6,"t":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ اُ۬لۡقِيَٰمَةِ"},{"a":7,"t":"فَإِذَا بَرِقَ اَ۬لۡبَصَرُ"},{"a":8,"t":"وَخَسَفَ اَ۬لۡقَمَرُ"},{"a":9,"t":"وَجُمِعَ اَ۬لشَّمۡسُ وَاَلۡقَمَرُ"},{"a":10,"t":"يَقُولُ اُ۬لۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ اَ۬لۡمَفَرُّ"},{"a":11,"t":"كَلَّا لَا وَزَرَ"},{"a":12,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ اِ۬لۡمُسۡتَقَرُّ"},{"a":13,"t":"يُنَبَّؤُاْ اُ۬لۡإِنسَٰنُ يَوۡمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَ"},{"a":14,"t":"بَلِ اِ۬لۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ‏"},{"a":15,"t":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ"},{"a":16,"t":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦ"},{"a":17,"t":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ"},{"a":18,"t":"فَإِذَا قَرَانَٰهُ فَاَتَّبِعۡ قُرۡءَانَهُۥ"},{"a":19,"t":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ"},{"a":20,"t":"كَلَّا بَلۡ يُحِبُّونَ اَ۬لۡعَاجِلَةَ"},{"a":21,"t":"وَيَذَرُونَ اَ۬لۡأٓخِرَةَ"},{"a":22,"t":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاضِرَةٌ"},{"a":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةࣱ‏"},{"a":24,"t":"وَوُجُوهࣱ يَوۡمَئِذِۢ بَاسِرَةࣱ‏"},{"a":25,"t":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةࣱ‏"},{"a":26,"t":"كَلَّا إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ"},{"a":27,"t":"وَقِيلَ مَن رَّاقࣲ‏"},{"a":28,"t":"وَظَنَّ أَنَّهُ اُ۬لۡفِرَاقُ"},{"a":29,"t":"وَاَلۡتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ"},{"a":30,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ اِ۬لۡمَسَاقُ"},{"a":31,"t":"فَلَا صَدَّقَ وَلَا صَلّٜ يٰ"},{"a":32,"t":"وَلَٰكِن كَذَّبَ وَتَوَلّٜ يٰ"},{"a":33,"t":"ثُمَّ ذَهَبَ إِلَىٰ أَهۡلِهِۦ يَتَمَطّٜ يٰ"},{"a":34,"t":"أَوۡلَىٰ لَكَ فَأَوۡلٜ يٰ"},{"a":35,"t":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلٜ يٰ"},{"a":36,"t":"أَيَحۡسِبُ اُ۬لۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى"},{"a":37,"t":"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ تُمۡنٜ يٰ"},{"a":38,"t":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوّٜ يٰ"},{"a":39,"t":"فَجَعَلَ مِنۡهُ اُ۬لزَّوۡجَيۡنِ اِ۬لذَّكَرَ وَاَلۡأُنثٜ يٰ"},{"a":40,"t":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَن يُحۡـِۧيَ اَ۬لۡمَوۡتٜ يٰ"}]}