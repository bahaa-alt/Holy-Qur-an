{"slug":"soosi","n":90,"verses":[{"a":1,"t":"لَا أُقۡسِم بِهَٰذَا اَ۬لۡبَلَدِ"},{"a":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لۡبَلَدِ"},{"a":3,"t":"وَوَالِدࣲ وَمَا وَلَدَ"},{"a":4,"t":"لَقَدۡ خَلَقۡنَا اَ۬لۡإِنسَٰنَ فِي كَبَدٍ"},{"a":5,"t":"أَيَحۡسِبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏"},{"a":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا"},{"a":7,"t":"أَيَحۡسِبُ أَن لَّمۡ يَرَهُۥ أَحَدٌ"},{"a":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"},{"a":9,"t":"وَلِسَانࣰ ا وَشَفَتَيۡنِ"},{"a":10,"t":"وَهَدَيۡنَٰهُ اُ۬لنَّجۡدَيۡنِ"},{"a":11,"t":"فَلَا اَ۪قۡتَحَمَ اَ۬لۡعَقَبَةَ"},{"a":12,"t":"وَمَا أَدۡر۪ىٰكَ مَا اَ۬لۡعَقَبَةُ"},{"a":13,"t":"فَكَّ رَقَبَةً"},{"a":14,"t":"أَوۡ أَطۡعَمَ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏"},{"a":15,"t":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ"},{"a":16,"t":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏"},{"a":17,"t":"ثُمَّ كَانَ مِنَ اَ۬لَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِالصَّبۡرِ وَتَوَاصَوۡاْ بِالۡمَرۡحَمَةِ"},{"a":18,"t":"أُوْلَٰٓئِكَ أَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ"},{"a":19,"t":"وَاَلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ اُ۬لۡمَشۡـَٔمَةِ"},{"a":20,"t":"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ"}]}