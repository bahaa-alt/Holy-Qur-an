{"slug":"shouba","n":80,"verses":[{"a":1,"t":"عَبَسَ وَتَوَلَّىٰٓ"},{"a":2,"t":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ"},{"a":3,"t":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"},{"a":4,"t":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ"},{"a":5,"t":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ"},{"a":6,"t":"فَأَنتَ لَهُۥ تَصَدَّىٰ"},{"a":7,"t":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ"},{"a":8,"t":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ"},{"a":9,"t":"وَهُوَ يَخۡشَىٰ"},{"a":10,"t":"فَأَنتَ عَنۡهُ تَلَهَّىٰ"},{"a":11,"t":"كَلَّآ إِنَّهَا تَذۡكِرَةࣱ‏"},{"a":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"a":13,"t":"فِي صُحُفࣲ مُّكَرَّمَةࣲ‏"},{"a":14,"t":"مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ"},{"a":15,"t":"بِأَيۡدِي سَفَرَةࣲ‏"},{"a":16,"t":"كِرَامِۭ بَرَرَةࣲ‏"},{"a":17,"t":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ"},{"a":18,"t":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ"},{"a":19,"t":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"a":20,"t":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"},{"a":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ"},{"a":22,"t":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"},{"a":23,"t":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ"},{"a":24,"t":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"},{"a":25,"t":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبࣰّ ا"},{"a":26,"t":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّ ا"},{"a":27,"t":"فَأَنۢبَتۡنَا فِيهَا حَبࣰّ ا"},{"a":28,"t":"وَعِنَبࣰ ا وَقَضۡبࣰ ا"},{"a":29,"t":"وَزَيۡتُونࣰ ا وَنَخۡلࣰ ا"},{"a":30,"t":"وَحَدَآئِقَ غُلۡبࣰ ا"},{"a":31,"t":"وَفَٰكِهَةࣰ وَأَبࣰّ ا"},{"a":32,"t":"مَّتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"},{"a":33,"t":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"},{"a":34,"t":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ"},{"a":35,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"a":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِ"},{"a":37,"t":"لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمۡ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِ"},{"a":38,"t":"وُجُوهࣱ يَوۡمَئِذࣲ مُّسۡفِرَةࣱ‏"},{"a":39,"t":"ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ‏"},{"a":40,"t":"وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ‏"},{"a":41,"t":"تَرۡهَقُهَا قَتَرَةٌ"},{"a":42,"t":"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ"}]}