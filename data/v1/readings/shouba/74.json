{"slug":"shouba","n":74,"verses":[{"a":1,"t":"يَٰٓأَيُّهَا ٱلۡمُدَّثِّرُ"},{"a":2,"t":"قُمۡ فَأَنذِرۡ"},{"a":3,"t":"وَرَبَّكَ فَكَبِّرۡ"},{"a":4,"t":"وَثِيَابَكَ فَطَهِّرۡ"},{"a":5,"t":"وَٱلرِّجۡزَ فَٱهۡجُرۡ"},{"a":6,"t":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ"},{"a":7,"t":"وَلِرَبِّكَ فَٱصۡبِرۡ"},{"a":8,"t":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ"},{"a":9,"t":"فَذَٰلِكَ يَوۡمَئِذࣲ يَوۡمٌ عَسِيرٌ"},{"a":10,"t":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرࣲ‏"},{"a":11,"t":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدࣰ ا"},{"a":12,"t":"وَجَعَلۡتُ لَهُۥ مَالࣰ ا مَّمۡدُودࣰ ا"},{"a":13,"t":"وَبَنِينَ شُهُودࣰ ا"},{"a":14,"t":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدࣰ ا"},{"a":15,"t":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ"},{"a":16,"t":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدࣰ ا"},{"a":17,"t":"سَأُرۡهِقُهُۥ صَعُودًا"},{"a":18,"t":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ"},{"a":19,"t":"فَقُتِلَ كَيۡفَ قَدَّرَ"},{"a":20,"t":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ"},{"a":21,"t":"ثُمَّ نَظَرَ"},{"a":22,"t":"ثُمَّ عَبَسَ وَبَسَرَ"},{"a":23,"t":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ"},{"a":24,"t":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ يُؤۡثَرُ"},{"a":25,"t":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ"},{"a":26,"t":"سَأُصۡلِيهِ سَقَرَ"},{"a":27,"t":"وَمَآ أَدۡرٜىٰكَ مَا سَقَرُ"},{"a":28,"t":"لَا تُبۡقِي وَلَا تَذَرُ"},{"a":29,"t":"لَوَّاحَةࣱ لِّلۡبَشَرِ"},{"a":30,"t":"عَلَيۡهَا تِسۡعَةَ عَشَرَ"},{"a":31,"t":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنࣰ ا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلࣰ اۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ"},{"a":32,"t":"كَلَّا وَٱلۡقَمَرِ"},{"a":33,"t":"وَٱلَّيۡلِ إِذَا دَبَرَ"},{"a":34,"t":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ"},{"a":35,"t":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ"},{"a":36,"t":"نَذِيرࣰ ا لِّلۡبَشَرِ"},{"a":37,"t":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ"},{"a":38,"t":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ"},{"a":39,"t":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ"},{"a":40,"t":"فِي جَنَّٰتࣲ يَتَسَآءَلُونَ"},{"a":41,"t":"عَنِ ٱلۡمُجۡرِمِينَ"},{"a":42,"t":"مَا سَلَكَكُمۡ فِي سَقَرَ"},{"a":43,"t":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ"},{"a":44,"t":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ"},{"a":45,"t":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ"},{"a":46,"t":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ"},{"a":47,"t":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ"},{"a":48,"t":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ"},{"a":49,"t":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ"},{"a":50,"t":"كَأَنَّهُمۡ حُمُرࣱ مُّسۡتَنفِرَةࣱ‏"},{"a":51,"t":"فَرَّتۡ مِن قَسۡوَرَةِۭ"},{"a":52,"t":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفࣰ ا مُّنَشَّرَةࣰ‏"},{"a":53,"t":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ"},{"a":54,"t":"كَلَّآ إِنَّهُۥ تَذۡكِرَةࣱ‏"},{"a":55,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"a":56,"t":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ"}]}