{"slug":"shouba","n":90,"verses":[{"a":1,"t":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ"},{"a":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ"},{"a":3,"t":"وَوَالِدࣲ وَمَا وَلَدَ"},{"a":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ"},{"a":5,"t":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏"},{"a":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا"},{"a":7,"t":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ"},{"a":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"},{"a":9,"t":"وَلِسَانࣰ ا وَشَفَتَيۡنِ"},{"a":10,"t":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ"},{"a":11,"t":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ"},{"a":12,"t":"وَمَآ أَدۡرٜىٰكَ مَا ٱلۡعَقَبَةُ"},{"a":13,"t":"فَكُّ رَقَبَةٍ"},{"a":14,"t":"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏"},{"a":15,"t":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ"},{"a":16,"t":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏"},{"a":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ"},{"a":18,"t":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"a":19,"t":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"a":20,"t":"عَلَيۡهِمۡ نَارࣱ مُّوصَدَةُۢ"}]}