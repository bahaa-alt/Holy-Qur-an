{"slug":"shouba","n":87,"verses":[{"a":1,"t":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى"},{"a":2,"t":"ٱلَّذِي خَلَقَ فَسَوَّىٰ"},{"a":3,"t":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ"},{"a":4,"t":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ"},{"a":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ"},{"a":6,"t":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ"},{"a":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ"},{"a":8,"t":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ"},{"a":9,"t":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ"},{"a":10,"t":"سَيَذَّكَّرُ مَن يَخۡشَىٰ"},{"a":11,"t":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى"},{"a":12,"t":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ"},{"a":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ"},{"a":14,"t":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ"},{"a":15,"t":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ"},{"a":16,"t":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"a":17,"t":"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ"},{"a":18,"t":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ"},{"a":19,"t":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ"}]}