{"slug":"shouba","n":107,"verses":[{"a":1,"t":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ"},{"a":2,"t":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ"},{"a":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"a":4,"t":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ"},{"a":5,"t":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ"},{"a":6,"t":"ٱلَّذِينَ هُمۡ يُرَآءُونَ"},{"a":7,"t":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ"}]}