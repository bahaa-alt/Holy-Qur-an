{"slug":"shouba","n":1,"verses":[{"a":1,"t":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"},{"a":2,"t":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ"},{"a":3,"t":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"},{"a":4,"t":"مَٰلِكِ يَوۡمِ ٱلدِّينِ"},{"a":5,"t":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ"},{"a":6,"t":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ"},{"a":7,"t":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ"}]}