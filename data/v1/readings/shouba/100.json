{"slug":"shouba","n":100,"verses":[{"a":1,"t":"وَٱلۡعَٰدِيَٰتِ ضَبۡحࣰ ا"},{"a":2,"t":"فَٱلۡمُورِيَٰتِ قَدۡحࣰ ا"},{"a":3,"t":"فَٱلۡمُغِيرَٰتِ صُبۡحࣰ ا"},{"a":4,"t":"فَأَثَرۡنَ بِهِۦ نَقۡعࣰ ا"},{"a":5,"t":"فَوَسَطۡنَ بِهِۦ جَمۡعًا"},{"a":6,"t":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ‏"},{"a":7,"t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ‏"},{"a":8,"t":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ"},{"a":9,"t":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ"},{"a":10,"t":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ"},{"a":11,"t":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ"}]}