{"slug":"shouba","n":55,"verses":[{"a":1,"t":"ٱلرَّحۡمَٰنُ"},{"a":2,"t":"عَلَّمَ ٱلۡقُرۡءَانَ"},{"a":3,"t":"خَلَقَ ٱلۡإِنسَٰنَ"},{"a":4,"t":"عَلَّمَهُ ٱلۡبَيَانَ"},{"a":5,"t":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانࣲ‏"},{"a":6,"t":"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ"},{"a":7,"t":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ"},{"a":8,"t":"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ"},{"a":9,"t":"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ"},{"a":10,"t":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ"},{"a":11,"t":"فِيهَا فَٰكِهَةࣱ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ"},{"a":12,"t":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ"},{"a":13,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":14,"t":"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلࣲ كَٱلۡفَخَّارِ"},{"a":15,"t":"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجࣲ مِّن نَّارࣲ‏"},{"a":16,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":17,"t":"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ"},{"a":18,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":19,"t":"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ"},{"a":20,"t":"بَيۡنَهُمَا بَرۡزَخࣱ لَّا يَبۡغِيَانِ"},{"a":21,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":22,"t":"يَخۡرُجُ مِنۡهُمَا ٱللُّولُؤُ وَٱلۡمَرۡجَانُ"},{"a":23,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":24,"t":"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشِـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ"},{"a":25,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":26,"t":"كُلُّ مَنۡ عَلَيۡهَا فَانࣲ‏"},{"a":27,"t":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ"},{"a":28,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":29,"t":"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنࣲ‏"},{"a":30,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":31,"t":"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ"},{"a":32,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"a":33,"t":"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنف