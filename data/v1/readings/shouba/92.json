{"slug":"shouba","n":92,"verses":[{"a":1,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ"},{"a":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"a":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"a":4,"t":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ"},{"a":5,"t":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ"},{"a":6,"t":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ"},{"a":7,"t":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"},{"a":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"},{"a":9,"t":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ"},{"a":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"},{"a":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"a":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ"},{"a":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ"},{"a":14,"t":"فَأَنذَرۡتُكُمۡ نَارࣰ ا تَلَظَّىٰ"},{"a":15,"t":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى"},{"a":16,"t":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"a":17,"t":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"},{"a":18,"t":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ"},{"a":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ"},{"a":20,"t":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ"},{"a":21,"t":"وَلَسَوۡفَ يَرۡضَىٰ"}]}