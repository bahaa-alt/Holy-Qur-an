{"slug":"warsh","n":78,"verses":[{"a":1,"t":"عَمَّۖ يَتَسَآءَلُونَ"},{"a":2,"t":"عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ"},{"a":3,"t":"اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ"},{"a":4,"t":"كَلَّا سَيَعْلَمُونَ"},{"a":5,"t":"ثُمَّ كَلَّا سَيَعْلَمُونَۖ"},{"a":6,"t":"أَلَمْ نَجْعَلِ اِ۬لَارْضَ مِهَٰداࣰ‏"},{"a":7,"t":"وَالْجِبَالَ أَوْتَاداࣰ‏"},{"a":8,"t":"وَخَلَقْنَٰكُمُۥٓ أَزْوَٰجاࣰ‏"},{"a":9,"t":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاࣰ‏"},{"a":10,"t":"وَجَعَلْنَا اَ۬ليْلَ لِبَاساࣰ‏"},{"a":11,"t":"وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاࣰ‏"},{"a":12,"t":"وَبَنَيْنَا فَوْقَكُمْ سَبْعاࣰ شِدَاداࣰ‏"},{"a":13,"t":"وَجَعَلْنَا سِرَاجاࣰ وَهَّاجاࣰ‏"},{"a":14,"t":"وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءࣰ ثَجَّاجاࣰ‏"},{"a":15,"t":"لِّنُخْرِجَ بِهِۦ حَبّاࣰ وَنَبَاتاࣰ‏"},{"a":16,"t":"وَجَنَّٰتٍ اَلْفَافاًۖ"},{"a":17,"t":"اِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاࣰ‏"},{"a":18,"t":"يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَاتُونَ أَفْوَاجاࣰ‏"},{"a":19,"t":"وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتَ اَبْوَٰباࣰ‏"},{"a":20,"t":"وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ"},{"a":21,"t":"اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداࣰ‏"},{"a":22,"t":"لِّلطَّٰغِينَ مَـَٔاباࣰ‏"},{"a":23,"t":"لَّٰبِثِينَ فِيهَآ أَحْقَاباࣰۖ"},{"a":24,"t":"لَّا يَذُوقُونَ فِيهَا بَرْداࣰ وَلَا شَرَاباً"},{"a":25,"t":"اِلَّا حَمِيماࣰ وَغَسَاقاࣰ‏"},{"a":26,"t":"جَزَآءࣰ وِفَاقاًۖ"},{"a":27,"t":"اِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباࣰ‏"},{"a":28,"t":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباࣰۖ"},{"a":29,"t":"وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ كِتَٰباࣰۖ"},{"a":30,"t":"فَذُوقُواْ فَلَن نَّزِيدَكُمُۥٓ إِلَّا عَذَاباًۖ"},{"a":31,"t":"اِنَّ لِلْمُتَّقِينَ مَفَازاً"},{"a":32,"t":"حَدَآئِقَ وَأَعْنَٰباࣰ‏"},{"a":33,"t":"وَكَوَاعِبَ أَتْرَاباࣰ‏"},{"a":34,"t":"وَكَأْساࣰ دِهَاقاࣰ‏"},{"a":35,"t":"لَّا يَسْمَعُونَ فِيهَا لَغْواࣰ وَلَا كِذَّاباࣰۖ"},{"a":36,"t":"جَزَآءࣰ مِّن رَّبِّكَ عَطَآءً حِسَاباࣰۖ"},{"a":37,"t":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباࣰۖ"},{"a":38,"t":"يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاࣰ لَّا يَتَكَلَّمُونَ إِلَّا مَنَ اَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباࣰۖ"},{"a":39,"t":"ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَيٰ رَبِّهِۦ مَـَٔاباًۖ"},{"a":40,"t":"اِنَّآ أَنذَرْنَٰكُمْ عَذَاباࣰ قَرِيباࣰ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباࣰۖ"}]}