{"slug":"warsh","n":80,"verses":[{"a":1,"t":"عَبَسَ وَتَوَلّ۪يٰٓ"},{"a":2,"t":"أَن جَآءَهُ اُ۬لَاعْم۪يٰۖ"},{"a":3,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكّ۪يٰٓ"},{"a":4,"t":"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪يٰٓۖ"},{"a":5,"t":"أَمَّا مَنِ اِ۪سْتَغْن۪يٰ"},{"a":6,"t":"فَأَنتَ لَهُۥ تَصَّدّ۪يٰ"},{"a":7,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪يٰۖ"},{"a":8,"t":"وَأَمَّا مَن جَآءَكَ يَسْع۪يٰ"},{"a":9,"t":"وَهُوَ يَخْش۪يٰ"},{"a":10,"t":"فَأَنتَ عَنْهُ تَلَهّ۪يٰ"},{"a":11,"t":"كَلَّآۖ إِنَّهَا تَذْكِرَةࣱۖ"},{"a":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"a":13,"t":"فِے صُحُفࣲ مُّكَرَّمَةࣲ‏"},{"a":14,"t":"مَّرْفُوعَةࣲ مُّطَهَّرَةِۢ"},{"a":15,"t":"بِأَيْدِے سَفَرَةࣲ‏"},{"a":16,"t":"كِرَامِۢ بَرَرَةࣲۖ"},{"a":17,"t":"قُتِلَ اَ۬لِانسَٰنُ مَآ أَكْفَرَهُۥۖ"},{"a":18,"t":"مِنَ اَيِّ شَےْءٍ خَلَقَهُۥۖ"},{"a":19,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"a":20,"t":"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ"},{"a":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ"},{"a":22,"t":"ثُمَّ إِذَا شَآءَ انشَرَهُۥۖ"},{"a":23,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥۖ"},{"a":24,"t":"فَلْيَنظُرِ اِ۬لِانسَٰنُ إِلَيٰ طَعَامِهِۦٓۖ"},{"a":25,"t":"إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاࣰ‏"},{"a":26,"t":"ثُمَّ شَقَقْنَا اَ۬لَارْضَ شَقّاࣰ‏"},{"a":27,"t":"فَأَنۢبَتْنَا فِيهَا حَبّاࣰ‏"},{"a":28,"t":"وَعِنَباࣰ وَقَضْباࣰ‏"},{"a":29,"t":"وَزَيْتُوناࣰ وَنَخْلاࣰ‏"},{"a":30,"t":"وَحَدَآئِقَ غُلْباࣰ‏"},{"a":31,"t":"وَفَٰكِهَةࣰ وَأَبّاࣰ‏"},{"a":32,"t":"مَّتَٰعاࣰ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"a":33,"t":"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ"},{"a":34,"t":"يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنَ اَخِيهِ"},{"a":35,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"a":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ"},{"a":37,"t":"لِكُلِّ اِ۪مْرِےࣲٕ مِّنْهُمْ يَوْمَئِذࣲ شَأْنࣱ يُغْنِيهِۖ"},{"a":38,"t":"وُجُوهࣱ يَوْمَئِذࣲ مُّسْفِرَةࣱ‏"},{"a":39,"t":"ضَاحِكَةࣱ مُّسْتَبْشِرَةࣱۖ"},{"a":40,"t":"وَوُجُوهࣱ يَوْمَئِذٍ عَلَيْهَا غَبَرَةࣱ‏"},{"a":41,"t":"تَرْهَقُهَا قَتَرَةٌۖ"},{"a":42,"t":"ا۟وْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ"}]}