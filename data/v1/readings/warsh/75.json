{"slug":"warsh","n":75,"verses":[{"a":1,"t":"ۖ لَآ أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ"},{"a":2,"t":"وَلَآ أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ"},{"a":3,"t":"أَيَحْسِبُ اُ۬لِانسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"a":4,"t":"بَل۪يٰۖ قَٰدِرِينَ عَلَيٰٓ أَن نُّسَوِّيَ بَنَانَهُۥۖ"},{"a":5,"t":"بَلْ يُرِيدُ اُ۬لِانسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ"},{"a":6,"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ"},{"a":7,"t":"فَإِذَا بَرَقَ اَ۬لْبَصَرُ"},{"a":8,"t":"وَخَسَفَ اَ۬لْقَمَرُ"},{"a":9,"t":"وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ"},{"a":10,"t":"يَقُولُ اُ۬لِانسَٰنُ يَوْمَئِذٍ اَيْنَ اَ۬لْمَفَرُّۖ"},{"a":11,"t":"كَلَّا لَا وَزَرَۖ"},{"a":12,"t":"إِلَيٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ"},{"a":13,"t":"يُنَبَّؤُاْ اُ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ"},{"a":14,"t":"بَلِ اِ۬لِانسَٰنُ عَلَيٰ نَفْسِهِۦ بَصِيرَةࣱ‏"},{"a":15,"t":"وَلَوَ اَلْق۪يٰ مَعَاذِيرَهُۥۖ"},{"a":16,"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓۖ"},{"a":17,"t":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ"},{"a":18,"t":"فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ"},{"a":19,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ"},{"a":20,"t":"كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ"},{"a":21,"t":"وَتَذَرُونَ اَ۬لَاخِرَةَۖ"},{"a":22,"t":"وُجُوهࣱ يَوْمَئِذࣲ نَّاضِرَةٌ"},{"a":23,"t":"اِلَيٰ رَبِّهَا نَاظِرَةࣱۖ"},{"a":24,"t":"وَوُجُوهࣱ يَوْمَئِذِۢ بَاسِرَةࣱ‏"},{"a":25,"t":"تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةࣱۖ"},{"a":26,"t":"كَلَّآ إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ"},{"a":27,"t":"وَقِيلَ مَن رَّاقࣲ‏"},{"a":28,"t":"وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ"},{"a":29,"t":"وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ"},{"a":30,"t":"إِلَيٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ"},{"a":31,"t":"فَلَا صَدَّقَ وَلَا صَلّ۪يٰۖ"},{"a":32,"t":"وَلَٰكِن كَذَّبَ وَتَوَلّ۪يٰۖ"},{"a":33,"t":"ثُمَّ ذَهَبَ إِلَيٰٓ أَهْلِهِۦ يَتَمَطّ۪يٰٓۖ"},{"a":34,"t":"أَوْل۪يٰ لَكَ فَأَوْل۪يٰ"},{"a":35,"t":"ثُمَّ أَوْل۪يٰ لَكَ فَأَوْل۪يٰٓۖ"},{"a":36,"t":"أَيَحْسِبُ اُ۬لِانسَٰنُ أَنْ يُّتْرَكَ سُديًۖ"},{"a":37,"t":"اَلَمْ يَكُ نُطْفَةࣰ مِّن مَّنِيࣲّ تُمْن۪يٰ"},{"a":38,"t":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوّ۪يٰ"},{"a":39,"t":"فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪يٰٓۖ"},{"a":40,"t":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَيٰٓ أَنْ يُّحْـِۧيَ اَ۬لْمَوْت۪يٰۖ"}]}