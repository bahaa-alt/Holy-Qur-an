{"slug":"warsh","n":79,"verses":[{"a":1,"t":"وَالنَّٰزِعَٰتِ غَرْقاࣰ‏"},{"a":2,"t":"وَالنَّٰشِطَٰتِ نَشْطاࣰ‏"},{"a":3,"t":"وَالسَّٰبِحَٰتِ سَبْحاࣰ‏"},{"a":4,"t":"فَالسَّٰبِقَٰتِ سَبْقاࣰ‏"},{"a":5,"t":"فَالْمُدَبِّرَٰتِ أَمْراࣰ‏"},{"a":6,"t":"يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ"},{"a":7,"t":"تَتْبَعُهَا اَ۬لرَّادِفَةُۖ"},{"a":8,"t":"قُلُوبࣱ يَوْمَئِذࣲ وَاجِفَةٌ"},{"a":9,"t":"اَبْصَٰرُهَا خَٰشِعَةࣱۖ"},{"a":10,"t":"يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ"},{"a":11,"t":"إِذَا كُنَّا عِظَٰماࣰ نَّخِرَةࣰۖ"},{"a":12,"t":"قَالُواْ تِلْكَ إِذاࣰ كَرَّةٌ خَاسِرَةࣱ‏"},{"a":13,"t":"فَإِنَّمَا هِيَ زَجْرَةࣱ وَٰحِدَةࣱ‏"},{"a":14,"t":"فَإِذَا هُم بِالسَّاهِرَةِۖ"},{"a":15,"t":"هَلَ اَت۪يٰكَ حَدِيثُ مُوس۪يٰٓ"},{"a":16,"t":"إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَيۖ"},{"a":17,"t":"اَ۪ذْهَبِ اِلَيٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪يٰ"},{"a":18,"t":"فَقُلْ هَل لَّكَ إِلَيٰٓ أَن تَزَّكّ۪يٰ"},{"a":19,"t":"وَأَهْدِيَكَ إِلَيٰ رَبِّكَ فَتَخْش۪يٰۖ"},{"a":20,"t":"فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪يٰ"},{"a":21,"t":"فَكَذَّبَ وَعَص۪يٰ"},{"a":22,"t":"ثُمَّ أَدْبَرَ يَسْع۪يٰ"},{"a":23,"t":"فَحَشَرَ فَنَاد۪يٰ"},{"a":24,"t":"فَقَالَ أَنَا رَبُّكُمُ اُ۬لَاعْل۪يٰ"},{"a":25,"t":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لَاخِرَةِ وَالُاول۪يٰٓۖ"},{"a":26,"t":"إِنَّ فِے ذَٰلِكَ لَعِبْرَةࣰ لِّمَنْ يَّخْش۪يٰٓۖ"},{"a":27,"t":"ءَآنتُمُۥٓ أَشَدُّ خَلْقاً اَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا"},{"a":28,"t":"رَفَعَ سَمْكَهَا فَسَوَّيٰهَا"},{"a":29,"t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ"},{"a":30,"t":"وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ"},{"a":31,"t":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا"},{"a":32,"t":"وَالْجِبَالَ أَرْسَيٰهَا"},{"a":33,"t":"مَتَٰعاࣰ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"a":34,"t":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪يٰ"},{"a":35,"t":"يَوْمَ يَتَذَكَّرُ اُ۬لِانسَٰنُ مَا سَع۪يٰ"},{"a":36,"t":"وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّر۪يٰۖ"},{"a":37,"t":"فَأَمَّا مَن طَغ۪يٰ"},{"a":38,"t":"وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا"},{"a":39,"t":"فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْو۪يٰۖ"},{"a":40,"t":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَي اَ۬لنَّفْسَ عَنِ اِ۬لْهَو۪يٰ"},{"a":41,"t":"فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْو۪يٰۖ"},{"a":42,"t":"۞يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ"},{"a":43,"t":"فِيمَ أَنتَ مِن ذِكْر۪يٰهَآۖ"},{"a":44,"t":"إِلَيٰ رَبِّكَ مُنتَهَيٰهَآۖ"},{"a":45,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ"},{"a":46,"t":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓاْ إِلَّا عَشِيَّةً اَوْ ضُحَيٰهَاۖ"}]}