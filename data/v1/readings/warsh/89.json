{"slug":"warsh","n":89,"verses":[{"a":1,"t":"وَالْفَجْرِ"},{"a":2,"t":"وَلَيَالٍ عَشْرࣲ‏"},{"a":3,"t":"وَالشَّفْعِ وَالْوَتْرِ"},{"a":4,"t":"وَاليْلِ إِذَا يَسْرِۦ"},{"a":5,"t":"هَلْ فِے ذَٰلِكَ قَسَمࣱ لِّذِے حِجْرٍۖ"},{"a":6,"t":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"a":7,"t":"اِرَمَ ذَاتِ اِ۬لْعِمَادِ"},{"a":8,"t":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ"},{"a":9,"t":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ"},{"a":10,"t":"وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ"},{"a":11,"t":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ"},{"a":12,"t":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ"},{"a":13,"t":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ"},{"a":14,"t":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ"},{"a":15,"t":"فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ"},{"a":16,"t":"وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"a":17,"t":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ"},{"a":18,"t":"وَلَا تَحُضُّونَ عَلَيٰ طَعَامِ اِ۬لْمِسْكِينِ"},{"a":19,"t":"وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاࣰ لَّمّاࣰ‏"},{"a":20,"t":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاࣰ جَمّاࣰ‏"},{"a":21,"t":"كَلَّآۖ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاࣰ دَكّاࣰ‏"},{"a":22,"t":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاࣰ صَفّاࣰ‏"},{"a":23,"t":"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ يَوْمَئِذࣲ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪يٰ لَهُ اُ۬لذِّكْر۪يٰۖ"},{"a":24,"t":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ"},{"a":25,"t":"فَيَوْمَئِذࣲ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدࣱ‏"},{"a":26,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدࣱۖ"},{"a":27,"t":"يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ"},{"a":28,"t":"اُ۪رْجِعِےٓ إِلَيٰ رَبِّكِ رَاضِيَةࣰ مَّرْضِيَّةࣰ‏"},{"a":29,"t":"فَادْخُلِے فِے عِبَٰدِے"},{"a":30,"t":"وَادْخُلِے جَنَّتِےۖ"}]}