{"slug":"warsh","n":104,"verses":[{"a":1,"t":"ۖ وَيْلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ"},{"a":2,"t":"اِ۬لذِے جَمَعَ مَالاࣰ وَعَدَّدَهُۥ"},{"a":3,"t":"يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"a":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ"},{"a":5,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ"},{"a":6,"t":"نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ"},{"a":7,"t":"اُ۬لتِے تَطَّلِعُ عَلَي اَ۬لَافْـِٕدَةِۖ"},{"a":8,"t":"إِنَّهَا عَلَيْهِم مُّوصَدَةࣱ‏"},{"a":9,"t":"فِے عَمَدࣲ مُّمَدَّدَةٍۖ"}]}