{"slug":"warsh","n":84,"verses":[{"a":1,"t":"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ"},{"a":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"a":3,"t":"وَإِذَا اَ۬لَارْضُ مُدَّتْ"},{"a":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"a":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ"},{"a":6,"t":"يَٰٓأَيُّهَا اَ۬لِانسَٰنُ إِنَّكَ كَادِحٌ اِلَيٰ رَبِّكَ كَدْحاࣰ فَمُلَٰقِيهِۖ"},{"a":7,"t":"فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"a":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَاباࣰ يَسِيراࣰ‏"},{"a":9,"t":"وَيَنقَلِبُ إِلَيٰٓ أَهْلِهِۦ مَسْرُوراࣰۖ"},{"a":10,"t":"وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"a":11,"t":"فَسَوْفَ يَدْعُواْ ثُبُوراࣰ‏"},{"a":12,"t":"وَيُصَلَّيٰ سَعِيراًۖ"},{"a":13,"t":"اِنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراًۖ"},{"a":14,"t":"اِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ"},{"a":15,"t":"بَل۪يٰٓۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراࣰۖ"},{"a":16,"t":"۞فَلَآ أُقْسِمُ بِالشَّفَقِ"},{"a":17,"t":"وَاليْلِ وَمَا وَسَقَ"},{"a":18,"t":"وَالْقَمَرِ إِذَا اَ۪تَّسَقَ"},{"a":19,"t":"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقࣲۖ"},{"a":20,"t":"فَمَا لَهُمْ لَا يُومِنُونَ"},{"a":21,"t":"وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَ۩ۖ"},{"a":22,"t":"بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"a":23,"t":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ"},{"a":24,"t":"فَبَشِّرْهُم بِعَذَابٍ اَلِيمٍۖ"},{"a":25,"t":"اِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونࣲۖ"}]}