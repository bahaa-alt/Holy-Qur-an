{"slug":"qumbul","n":88,"verses":[{"a":1,"t":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ"},{"a":2,"t":"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ"},{"a":3,"t":"عَامِلَةࣱ نَّاصِبَةࣱ‏"},{"a":4,"t":"تَصۡلَىٰ نَارًا حَامِيَةࣰ‏"},{"a":5,"t":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏"},{"a":6,"t":"لَّيۡسَ لَهُمُۥ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏"},{"a":7,"t":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏"},{"a":8,"t":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏"},{"a":9,"t":"لِّسَعۡيِهَا رَاضِيَةࣱ‏"},{"a":10,"t":"فِي جَنَّةٍ عَالِيَةࣲ‏"},{"a":11,"t":"لَّا يُسۡمَعُ فِيهَا لَٰغِيَةࣱ‏"},{"a":12,"t":"فِيهَا عَيۡنࣱ جَارِيَةࣱ‏"},{"a":13,"t":"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏"},{"a":14,"t":"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏"},{"a":15,"t":"وَنَمَارِقُ مَصۡفُوفَةࣱ‏"},{"a":16,"t":"وَزَرَابِيُّ مَبۡثُوثَةٌ"},{"a":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ"},{"a":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ"},{"a":19,"t":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ"},{"a":20,"t":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ"},{"a":21,"t":"فَذَكِّرۡ إِنَّمَا أَنتَ مُذَكِّرࣱ‏"},{"a":22,"t":"لَّسۡتَ عَلَيۡهِمُۥ بِمُصَيۡطِرٍ"},{"a":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"a":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ"},{"a":25,"t":"إِنَّ إِلَيۡنَا إِيَابَهُمُۥ"},{"a":26,"t":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُمُۥ"}]}