{"slug":"qumbul","n":96,"verses":[{"a":1,"t":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ"},{"a":2,"t":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ"},{"a":3,"t":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ"},{"a":4,"t":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ"},{"a":5,"t":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ"},{"a":6,"t":"كَلَّا إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰ"},{"a":7,"t":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰ"},{"a":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰ"},{"a":9,"t":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ"},{"a":10,"t":"عَبۡدًا إِذَا صَلَّىٰ"},{"a":11,"t":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰ"},{"a":12,"t":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰ"},{"a":13,"t":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰ"},{"a":14,"t":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"a":15,"t":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ"},{"a":16,"t":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏"},{"a":17,"t":"فَلۡيَدۡعُ نَادِيَهُۥ"},{"a":18,"t":"سَنَدۡعُ ٱلزَّبَانِيَةَ"},{"a":19,"t":"كَلَّا لَا تُطِعۡهُۥ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩"}]}