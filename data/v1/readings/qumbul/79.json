{"slug":"qumbul","n":79,"verses":[{"a":1,"t":"وَٱلنَّٰزِعَٰتِ غَرۡقࣰ ا"},{"a":2,"t":"وَٱلنَّٰشِطَٰتِ نَشۡطࣰ ا"},{"a":3,"t":"وَٱلسَّٰبِحَٰتِ سَبۡحࣰ ا"},{"a":4,"t":"فَٱلسَّٰبِقَٰتِ سَبۡقࣰ ا"},{"a":5,"t":"فَٱلۡمُدَبِّرَٰتِ أَمۡرࣰ ا"},{"a":6,"t":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ"},{"a":7,"t":"تَتۡبَعُهَا ٱلرَّادِفَةُ"},{"a":8,"t":"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ"},{"a":9,"t":"أَبۡصَٰرُهَا خَٰشِعَةࣱ‏"},{"a":10,"t":"يَقُولُونَ أَ۟نَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ"},{"a":11,"t":"أَ۟ذَا كُنَّا عِظَٰمࣰ ا نَّخِرَةࣰ‏"},{"a":12,"t":"قَالُواْ تِلۡكَ إِذࣰ ا كَرَّةٌ خَاسِرَةࣱ‏"},{"a":13,"t":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ‏"},{"a":14,"t":"فَإِذَا هُمُۥ بِٱلسَّاهِرَةِ"},{"a":15,"t":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰ"},{"a":16,"t":"إِذۡ نَادَىٰهُۥ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوَى"},{"a":17,"t":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ"},{"a":18,"t":"فَقُلۡ هَل لَّكَ إِلَىٰ أَن تَزَّكَّىٰ"},{"a":19,"t":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ"},{"a":20,"t":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ"},{"a":21,"t":"فَكَذَّبَ وَعَصَىٰ"},{"a":22,"t":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ"},{"a":23,"t":"فَحَشَرَ فَنَادَىٰ"},{"a":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ"},{"a":25,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰ"},{"a":26,"t":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشَىٰ"},{"a":27,"t":"ءَا۬نتُمُۥ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا"},{"a":28,"t":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا"},{"a":29,"t":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا"},{"a":30,"t":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَا"},{"a":31,"t":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا"},{"a":32,"t":"وَٱلۡجِبَالَ أَرۡسَىٰهَا"},{"a":33,"t":"مَتَٰعࣰ ا لَّكُمُۥ وَلِأَنۡعَٰمِكُمُۥ"},{"a":34,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ"},{"a":35,"t":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ"},{"a":36,"t":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ"},{"a":37,"t":"فَأَمَّا مَن طَغَىٰ"},{"a":38,"t":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"a":39,"t":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ"},{"a":40,"t":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ"},{"a":41,"t":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ"},{"a":42,"t":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا"},{"a":43,"t":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَا"},{"a":44,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَا"},{"a":45,"t":"إِنَّمَا أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا"},{"a":46,"t":"كَأَنَّهُمُۥ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُواْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا"}]}