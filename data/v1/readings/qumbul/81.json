{"slug":"qumbul","n":81,"verses":[{"a":1,"t":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ"},{"a":2,"t":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ"},{"a":3,"t":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ"},{"a":4,"t":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ"},{"a":5,"t":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ"},{"a":6,"t":"وَإِذَا ٱلۡبِحَارُ سُجِرَتۡ"},{"a":7,"t":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ"},{"a":8,"t":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ"},{"a":9,"t":"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ"},{"a":10,"t":"وَإِذَا ٱلصُّحُفُ نُشِّرَتۡ"},{"a":11,"t":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ"},{"a":12,"t":"وَإِذَا ٱلۡجَحِيمُ سُعِرَتۡ"},{"a":13,"t":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ"},{"a":14,"t":"عَلِمَتۡ نَفۡسࣱ مَّا أَحۡضَرَتۡ"},{"a":15,"t":"فَلَا أُقۡسِمُ بِٱلۡخُنَّسِ"},{"a":16,"t":"ٱلۡجَوَارِ ٱلۡكُنَّسِ"},{"a":17,"t":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ"},{"a":18,"t":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ"},{"a":19,"t":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏"},{"a":20,"t":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ‏"},{"a":21,"t":"مُّطَاعࣲ ثَمَّ أَمِينࣲ‏"},{"a":22,"t":"وَمَا صَاحِبُكُمُۥ بِمَجۡنُونࣲ‏"},{"a":23,"t":"وَلَقَدۡ رَءَاهُۥ بِٱلۡأُفُقِ ٱلۡمُبِينِ"},{"a":24,"t":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضظَنِينࣲ‏"},{"a":25,"t":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ‏"},{"a":26,"t":"فَأَيۡنَ تَذۡهَبُونَ"},{"a":27,"t":"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ"},{"a":28,"t":"لِمَن شَآءَ مِنكُمُۥ أَن يَسۡتَقِيمَ"},{"a":29,"t":"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ"}]}