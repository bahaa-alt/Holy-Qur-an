{"slug":"bazzi","n":82,"verses":[{"a":1,"t":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ"},{"a":2,"t":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ"},{"a":3,"t":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ"},{"a":4,"t":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ"},{"a":5,"t":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ"},{"a":6,"t":"يَٰأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ"},{"a":7,"t":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ"},{"a":8,"t":"فِي أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ"},{"a":9,"t":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ"},{"a":10,"t":"وَإِنَّ عَلَيۡكُمُۥ لَحَٰفِظِينَ"},{"a":11,"t":"كِرَامࣰ ا كَٰتِبِينَ"},{"a":12,"t":"يَعۡلَمُونَ مَا تَفۡعَلُونَ"},{"a":13,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ‏"},{"a":14,"t":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ‏"},{"a":15,"t":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ"},{"a":16,"t":"وَمَا هُمُۥ عَنۡهَا بِغَآئِبِينَ"},{"a":17,"t":"وَمَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"a":18,"t":"ثُمَّ مَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"a":19,"t":"يَوۡمُ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔ اۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ"}]}