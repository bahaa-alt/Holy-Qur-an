{"slug":"bazzi","n":56,"verses":[{"a":1,"t":"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ"},{"a":2,"t":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ"},{"a":3,"t":"خَافِضَةࣱ رَّافِعَةٌ"},{"a":4,"t":"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجࣰّ ا"},{"a":5,"t":"وَبُسَّتِ ٱلۡجِبَالُ بَسࣰّ ا"},{"a":6,"t":"فَكَانَتۡ هَبَآءࣰ مُّنۢبَثࣰّ ا"},{"a":7,"t":"وَكُنتُمُۥ أَزۡوَٰجࣰ ا ثَلَٰثَةࣰ‏"},{"a":8,"t":"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَا أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"a":9,"t":"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَا أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"a":10,"t":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ"},{"a":11,"t":"أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ"},{"a":12,"t":"فِي جَنَّٰتِ ٱلنَّعِيمِ"},{"a":13,"t":"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ"},{"a":14,"t":"وَقَلِيلࣱ مِّنَ ٱلۡأٓخِرِينَ"},{"a":15,"t":"عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ‏"},{"a":16,"t":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ"},{"a":17,"t":"يَطُوفُ عَلَيۡهِمُۥ وِلۡدَٰنࣱ مُّخَلَّدُونَ"},{"a":18,"t":"بِأَكۡوَابࣲ وَأَبَارِيقَ وَكَأۡسࣲ مِّن مَّعِينࣲ‏"},{"a":19,"t":"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ"},{"a":20,"t":"وَفَٰكِهَةࣲ مِّمَّا يَتَخَيَّرُونَ"},{"a":21,"t":"وَلَحۡمِ طَيۡرࣲ مِّمَّا يَشۡتَهُونَ"},{"a":22,"t":"وَحُورٌ عِينࣱ‏"},{"a":23,"t":"كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ"},{"a":24,"t":"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ"},{"a":25,"t":"لَا يَسۡمَعُونَ فِيهَا لَغۡوࣰ ا وَلَا تَأۡثِيمًا"},{"a":26,"t":"إِلَّا قِيلࣰ ا سَلَٰمࣰ ا سَلَٰمࣰ ا"},{"a":27,"t":"وَأَصۡحَٰبُ ٱلۡيَمِينِ مَا أَصۡحَٰبُ ٱلۡيَمِينِ"},{"a":28,"t":"فِي سِدۡرࣲ مَّخۡضُودࣲ‏"},{"a":29,"t":"وَطَلۡحࣲ مَّنضُودࣲ‏"},{"a":30,"t":"وَظِلࣲّ مَّمۡدُودࣲ‏"},{"a":31,"t":"وَمَآءࣲ مَّسۡكُوبࣲ‏"},{"a":32,"t":"وَفَٰكِهَةࣲ كَثِيرَةࣲ‏"},{"a":33,"t":"لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ‏"},{"a":34,"t":"وَفُرُشࣲ مَّرۡفُوعَةٍ"},{"a":35,"t":"إِنَّا أَنشَأۡنَٰهُنَّ إِنشَآءࣰ‏"},{"a":36,"t":"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا"},{"a":37,"t":"عُرُبًا أَتۡرَابࣰ ا"},{"a":38,"t":"لِّأَصۡحَٰبِ ٱلۡيَمِينِ"},{"a":39,"t":"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ"},{"a":40,"t":"وَثُلَّةࣱ مِّنَ ٱلۡأٓخِرِينَ"},{"a":41,"t":"وَأَصۡحَٰبُ ٱلشِّمَالِ مَا أَصۡحَٰبُ ٱلشِّمَالِ"},{"a":42,"t":"فِي سَمُومࣲ وَحَمِيمࣲ‏"},{"a":43,"t":"وَظِلࣲّ مِّن يَحۡمُومࣲ‏"},{"a":44,"t":"لَّا بَارِدࣲ وَلَا كَرِيمٍ"},{"a":45,"t":"إِنَّهُمُۥ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ"},{"a":46,"t":"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ"},{"a":47,"t":"وَكَانُواْ يَقُولُونَ أَى۪ذَا مُتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَ۟نَّا لَمَبۡعُوثُونَ"},{"a":48,"t":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ"},{"a":49,"t":"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ"},{"a":50,"t":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمࣲ مَّعۡلُومࣲ‏"},{"a":51,"t":"ثُمَّ إِنَّكُمُۥ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ"},{"a":52,"t":"لَأٓكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ‏"},{"a":53,"t":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ"},{"a":54,"t":"فَشَٰرِبُونَ عَلَيۡهِۦ مِنَ ٱلۡحَمِيمِ"},{"a":55,"t":"فَشَٰرِبُونَ شَرۡبَ ٱلۡهِيمِ"},{"a":56,"t":"هَٰذَا نُزُلُهُمُۥ يَوۡمَ ٱلدِّينِ"},{"a":57,"t":"نَحۡنُ خَلَقۡنَٰكُمُۥ فَلَوۡلَا تُصَدِّقُونَ"},{"a":58,"t":"أَفَرَءَيۡتُمُۥ مَا تُمۡنُونَ"},{"a":59,"t":"ءَا۬نتُمُۥ تَخۡلُقُونَهُۥ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ"},{"a":60,"t":"نَحۡنُ قَدَرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ"},{"a":61,"t":"عَلَىٰ أَن نُّبَدِّلَ أَمۡثَٰلَكُمُۥ وَنُنشِئَكُمُۥ فِي مَا لَا تَعۡلَمُونَ"},{"a":62,"t":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشَآءَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَّكَّرُونَ"},{"a":63,"t":"أَفَرَءَيۡتُمُۥ مَا تَحۡرُثُونَ"},{"a":64,"t":"ءَا۬نتُمُۥ تَزۡرَعُونَهُۥ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ"},{"a":65,"t":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُۥ حُطَٰمࣰ ا فَظَلۡتُمُۥ تَفَكَّهُونَ"},{"a":66,"t":"إِنَّا لَمُغۡرَمُونَ"},{"a":67,"t":"بَلۡ نَحۡنُ مَحۡرُومُونَ"},{"a":68,"t":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ"},{"a":69,"t":"ءَا۬نتُمُۥ أَنزَلۡتُمُوهُۥ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ"},{"a":70,"t":"لَوۡ نَشَآءُ جَعَلۡنَٰهُۥ أُجَاجࣰ ا فَلَوۡلَا تَشۡكُرُونَ"},{"a":71,"t":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ"},{"a":72,"t":"ءَا۬نتُمُۥ أَنشَأۡتُمُۥ شَجَرَتَهَا أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ"},{"a":73,"t":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةࣰ وَمَتَٰعࣰ ا لِّلۡمُقۡوِينَ"},{"a":74,"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"},{"a":75,"t":"۞فَلَا أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"},{"a":76,"t":"وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِيمٌ"},{"a":77,"t":"إِنَّهُۥ لَقُرَانࣱ كَرِيمࣱ‏"},{"a":78,"t":"فِي كِتَٰبࣲ مَّكۡنُونࣲ‏"},{"a":79,"t":"لَّا يَمَسُّهُۥ إِلَّا ٱلۡمُطَهَّرُونَ"},{"a":80,"t":"تَنزِيلࣱ مِّن رَّبِّ ٱلۡعَٰلَمِينَ"},{"a":81,"t":"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُمُۥ مُدۡهِنُونَ"},{"a":82,"t":"وَتَجۡعَلُونَ رِزۡقَكُمُۥ أَنَّكُمُۥ تُكَذِّبُونَ"},{"a":83,"t":"فَلَوۡلَا إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ"},{"a":84,"t":"وَأَنتُمُۥ حِينَئِذࣲ تَنظُرُونَ"},{"a":85,"t":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِۦ مِنكُمُۥ وَلَٰكِن لَّا تُبۡصِرُونَ"},{"a":86,"t":"فَلَوۡلَا إِن كُنتُمُۥ غَيۡرَ مَدِينِينَ"},{"a":87,"t":"تَرۡجِعُونَهَا إِن كُنتُمُۥ صَٰدِقِينَ"},{"a":88,"t":"فَأَمَّا إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ"},{"a":89,"t":"فَرَوۡحࣱ وَرَيۡحَانࣱ وَجَنَّتُ نَعِيمࣲ‏"},{"a":90,"t":"وَأَمَّا إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ"},{"a":91,"t":"فَسَلَٰمࣱ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ"},{"a":92,"t":"وَأَمَّا إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ"},{"a":93,"t":"فَنُزُلࣱ مِّنۡ حَمِيمࣲ‏"},{"a":94,"t":"وَتَصۡلِيَةُ جَحِيمٍ"},{"a":95,"t":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ"},{"a":96,"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"}]}