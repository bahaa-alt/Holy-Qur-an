{"slug":"bazzi","n":77,"verses":[{"a":1,"t":"وَٱلۡمُرۡسَلَٰتِ عُرۡفࣰ ا"},{"a":2,"t":"فَٱلۡعَٰصِفَٰتِ عَصۡفࣰ ا"},{"a":3,"t":"وَٱلنَّٰشِرَٰتِ نَشۡرࣰ ا"},{"a":4,"t":"فَٱلۡفَٰرِقَٰتِ فَرۡقࣰ ا"},{"a":5,"t":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا"},{"a":6,"t":"عُذۡرًا أَوۡ نُذُرًا"},{"a":7,"t":"إِنَّمَا تُوعَدُونَ لَوَٰقِعࣱ‏"},{"a":8,"t":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ"},{"a":9,"t":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ"},{"a":10,"t":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ"},{"a":11,"t":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ"},{"a":12,"t":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ"},{"a":13,"t":"لِيَوۡمِ ٱلۡفَصۡلِ"},{"a":14,"t":"وَمَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ"},{"a":15,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":16,"t":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ"},{"a":17,"t":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ"},{"a":18,"t":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"},{"a":19,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":20,"t":"أَلَمۡ نَخۡلُقكُّمُۥ مِن مَّآءࣲ مَّهِينࣲ‏"},{"a":21,"t":"فَجَعَلۡنَٰهُۥ فِي قَرَارࣲ مَّكِينٍ"},{"a":22,"t":"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ‏"},{"a":23,"t":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ"},{"a":24,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":25,"t":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا"},{"a":26,"t":"أَحۡيَآءࣰ وَأَمۡوَٰتࣰ ا"},{"a":27,"t":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسۡقَيۡنَٰكُمُۥ مَآءࣰ فُرَاتࣰ ا"},{"a":28,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":29,"t":"ٱنطَلِقُواْ إِلَىٰ مَا كُنتُمُۥ بِهِۦ تُكَذِّبُونَ"},{"a":30,"t":"ٱنطَلِقُواْ إِلَىٰ ظِلࣲّ ذِي ثَلَٰثِ شُعَبࣲ‏"},{"a":31,"t":"لَّا ظَلِيلࣲ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ"},{"a":32,"t":"إِنَّهَا تَرۡمِي بِشَرَرࣲ كَٱلۡقَصۡرِ"},{"a":33,"t":"كَأَنَّهُۥ جِمَٰلَٰتࣱ صُفۡرࣱ‏"},{"a":34,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":35,"t":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ"},{"a":36,"t":"وَلَا يُؤۡذَنُ لَهُمُۥ فَيَعۡتَذِرُونَ"},{"a":37,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":38,"t":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمُۥ وَٱلۡأَوَّلِينَ"},{"a":39,"t":"فَإِن كَانَ لَكُمُۥ كَيۡدࣱ فَكِيدُونِ"},{"a":40,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":41,"t":"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلࣲ وَعِيُونࣲ‏"},{"a":42,"t":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ"},{"a":43,"t":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمُۥ تَعۡمَلُونَ"},{"a":44,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"a":45,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":46,"t":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُمُۥ مُجۡرِمُونَ"},{"a":47,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":48,"t":"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ"},{"a":49,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":50,"t":"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ"}]}