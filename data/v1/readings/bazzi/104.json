{"slug":"bazzi","n":104,"verses":[{"a":1,"t":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ"},{"a":2,"t":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ"},{"a":3,"t":"يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ"},{"a":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ"},{"a":5,"t":"وَمَا أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ"},{"a":6,"t":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ"},{"a":7,"t":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ"},{"a":8,"t":"إِنَّهَا عَلَيۡهِمُۥ مُوصَدَةࣱ‏"},{"a":9,"t":"فِي عَمَدࣲ مُّمَدَّدَةِۭ"}]}