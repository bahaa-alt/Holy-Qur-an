{"slug":"qaloon","n":100,"verses":[{"a":1,"t":"وَالْعَٰدِيَٰتِ ضَبْحاࣰ‏"},{"a":2,"t":"فَالْمُورِيَٰتِ قَدْحاࣰ‏"},{"a":3,"t":"فَالْمُغِيرَٰتِ صُبْحاࣰ‏"},{"a":4,"t":"فَأَثَرْنَ بِهِۦ نَقْعاࣰ‏"},{"a":5,"t":"فَوَسَطْنَ بِهِۦ جَمْعاً"},{"a":6,"t":"إِنَّ اَ۬لْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ‏"},{"a":7,"t":"وَإِنَّهُۥ عَلَيٰ ذَٰلِكَ لَشَهِيدࣱ‏"},{"a":8,"t":"وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ‏"},{"a":9,"t":"۞أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ"},{"a":10,"t":"وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ"},{"a":11,"t":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذࣲ لَّخَبِيرُۢۖ‏"}]}