{"slug":"qaloon","n":37,"verses":[{"a":1,"t":"وَالصَّٰٓفَّٰتِ صَفّاࣰ‏"},{"a":2,"t":"فَالزَّٰجِرَٰتِ زَجْراࣰ‏"},{"a":3,"t":"فَالتَّٰلِيَٰتِ ذِكْراً"},{"a":4,"t":"إِنَّ إِلَٰهَكُمْ لَوَٰحِدࣱۖ‏"},{"a":5,"t":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ‏"},{"a":6,"t":"إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْيَا بِزِينَةِ اِ۬لْكَوَاكِبِۖ‏"},{"a":7,"t":"وَحِفْظاࣰ مِّن كُلِّ شَيْطَٰنࣲ مَّارِدࣲۖ‏"},{"a":8,"t":"لَّا يَسْمَعُونَ إِلَي اَ۬لْمَلَإِ اِ۬لْأَعْلَيٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبࣲۖ‏"},{"a":9,"t":"دُحُوراࣰۖ وَلَهُمْ عَذَابࣱ وَاصِبٌ"},{"a":10,"t":"إِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابࣱ ثَاقِبࣱۖ‏"},{"a":11,"t":"فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقاً أَم مَّنْ خَلَقْنَاۖ إِنَّا خَلَقْنَٰهُم مِّن طِينࣲ لَّٰزِبِۢۖ‏"},{"a":12,"t":"بَلْ عَجِبْتَ وَيَسْخَرُونَۖ‏"},{"a":13,"t":"وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ‏"},{"a":14,"t":"وَإِذَا رَأَوْاْ ءَايَةࣰ يَسْتَسْخِرُونَۖ‏"},{"a":15,"t":"وَقَالُواْ إِنْ هَٰذَا إِلَّا سِحْرࣱ مُّبِينٌ"},{"a":16,"t":"أَٰ۟ذَا مِتْنَا وَكُنَّا تُرَاباࣰ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ"},{"a":17,"t":"أَوْ ءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ‏"},{"a":18,"t":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ‏"},{"a":19,"t":"فَإِنَّمَا هِيَ زَجْرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمْ يَنظُرُونَۖ‏"},{"a":20,"t":"وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ‏"},{"a":21,"t":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ‏"},{"a":22,"t":"۞اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ"},{"a":23,"t":"مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمْ إِلَيٰ صِرَٰطِ اِ۬لْجَحِيمِۖ‏"},{"a":24,"t":"وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَۖ‏"},{"a":25,"t":"مَا لَكُمْ لَا تَنَاصَرُونَۖ‏"},{"a":26,"t":"بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ‏"},{"a":27,"t":"وَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضࣲ يَتَسَآءَلُونَۖ‏"},{"a":28,"t":"قَالُواْ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ اِ۬لْيَمِينِۖ‏"},{"a":29,"t":"قَالُواْ بَل لَّمْ تَكُونُواْ مُؤْمِنِينَۖ‏"},{"a":30,"t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماࣰ طَٰغِينَۖ‏"},{"a":31,"t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا إِنَّا لَذَآئِقُونَ"},{"a":32,"t":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَۖ‏"},{"a":33,"t":"فَإِنَّهُمْ يَوْمَئِذࣲ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ‏"},{"a":34,"t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ‏"},{"a":35,"t":"إِنَّهُمْ كَانُواْ إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ"},{"a":36,"t":"وَيَقُولُونَ أَٰئِنَّا لَتَارِكُواْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجْنُونِۢۖ‏"},{"a":37,"t":"بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ‏"},{"a":38,"t":"إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لْأَلِيمِۖ‏"},{"a":39,"t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"a":40,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ‏"},{"a":41,"t":"أُوْلَٰٓئِكَ لَهُمْ رِزْقࣱ مَّعْلُومࣱ‏"},{"a":42,"t":"فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ"},{"a":43,"t":"فِے جَنَّٰتِ اِ۬لنَّعِيمِ"},{"a":44,"t":"عَلَيٰ سُرُرࣲ مُّتَقَٰبِلِينَۖ‏"},{"a":45,"t":"يُطَافُ عَلَيْهِم بِكَأْسࣲ مِّن مَّعِينِۢ"},{"a":46,"t":"بَيْضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ"},{"a":47,"t":"لَا فِيهَا غَوْلࣱ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ‏"},{"a":48,"t":"وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينࣱ‏"},{"a":49,"t":"كَأَنَّهُنَّ بَيْضࣱ مَّكْنُونࣱۖ‏"},{"a":50,"t":"فَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضࣲ يَتَسَآءَلُونَۖ‏"},{"a":51,"t":"۞قَالَ قَآئِلࣱ مِّنْهُمْ إِنِّے كَانَ لِے قَرِينࣱ‏"},{"a":52,"t":"يَقُولُ أَٰ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ"},{"a":53,"t":"أَٰ۟ذَا مِتْنَا وَكُنَّا تُرَاباࣰ وَعِظَٰماً إِنَّا لَمَدِينُونَۖ‏"},{"a":54,"t":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"},{"a":55,"t":"فَاطَّلَعَ فَرَءَاهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ‏"},{"a":56,"t":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ"},{"a":57,"t":"وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ‏"},{"a":58,"t":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"a":59,"t":"إِلَّا مَوْتَتَنَا اَ۬لْأُولَيٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ‏"},{"a":60,"t":"إِنَّ هَٰذَا لَهْوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ‏"},{"a":61,"t":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ‏"},{"a":62,"t":"أَذَٰلِكَ خَيْرࣱ نُّزُلاً أَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ‏"},{"a":63,"t":"إِنَّا جَعَلْنَٰهَا فِتْنَةࣰ لِّلظَّٰلِمِينَۖ‏"},{"a":64,"t":"إِنَّهَا شَجَرَةࣱ تَخْرُجُ فِے أَصْلِ اِ۬لْجَحِيمِ"},{"a":65,"t":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ‏"},{"a":66,"t":"فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"},{"a":67,"t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباࣰ مِّنْ حَمِيمࣲۖ‏"},{"a":68,"t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَي اَ۬لْجَحِيمِۖ‏"},{"a":69,"t":"إِنَّهُمْ أَلْفَوْاْ ءَابَآءَهُمْ ضَآلِّينَ"},{"a":70,"t":"فَهُمْ عَلَيٰ ءَاثَٰرِهِمْ يُهْرَعُونَۖ‏"},{"a":71,"t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ اُ۬لْأَوَّلِينَۖ‏"},{"a":72,"t":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَۖ‏"},{"a":73,"t":"فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ"},{"a":74,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ‏"},{"a":75,"t":"وَلَقَدْ نَادَيٰنَا نُوحࣱۖ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ‏"},{"a":76,"t":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ‏"},{"a":77,"t":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ‏"},{"a":78,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ‏"},{"a":79,"t":"سَلَٰمٌ عَلَيٰ نُوحࣲ فِے اِ۬لْعَٰلَمِينَۖ‏"},{"a":80,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ‏"},{"a":81,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ‏"},{"a":82,"t":"ثُمَّ أَغْرَقْنَا اَ۬لْأٓخَرِينَۖ‏"},{"a":83,"t":"۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"},{"a":84,"t":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبࣲ سَلِيمٍ"},{"a":85,"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ‏"},{"a":86,"t":"أَٰئِفْكاً ءَالِهَةࣰ دُونَ اَ۬للَّهِ تُرِيدُونَۖ‏"},{"a":87,"t":"فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ‏"},{"a":88,"t":"فَنَظَرَ نَظْرَةࣰ فِے اِ۬لنُّجُومِ"},{"a":89,"t":"فَقَالَ إِنِّے سَقِيمࣱ‏"},{"a":90,"t":"فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ‏"},{"a":91,"t":"فَرَاغَ إِلَيٰ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"},{"a":92,"t":"مَا لَكُمْ لَا تَنطِقُونَۖ‏"},{"a":93,"t":"فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ"},{"a":94,"t":"فَأَقْبَلُواْ إِلَيْهِ يَزِفُّونَۖ‏"},{"a":95,"t":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},{"a":96,"t":"وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ‏"},{"a":97,"t":"قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناࣰ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ"},{"a":98,"t":"فَأَرَادُواْ بِهِۦ كَيْداࣰ فَجَعَلْنَٰهُمُ اُ۬لْأَسْفَلِينَۖ‏"},{"a":99,"t":"وَقَالَ إِنِّے ذَاهِبٌ إِلَيٰ رَبِّے سَيَهْدِينِۖ‏"},{"a":100,"t":"رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ‏"},{"a":101,"t":"فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمࣲۖ‏"},{"a":102,"t":"فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَرَيٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَرَيٰۖ قَالَ يَٰأَبَتِ اِ۪فْعَلْ مَا تُؤْمَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ‏"},{"a":103,"t":"فَلَمَّا أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"},{"a":104,"t":"وَنَٰدَيْنَٰهُ أَنْ يَّٰإِبْرَٰهِيمُ"},{"a":105,"t":"قَدْ صَدَّقْتَ اَ۬لرُّءْيَاۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ‏"},{"a":106,"t":"إِنَّ هَٰذَا لَهْوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ‏"},{"a":107,"t":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمࣲۖ‏"},{"a":108,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ‏"},{"a":109,"t":"سَلَٰمٌ عَلَيٰ إِبْرَٰهِيمَۖ‏"},{"a":110,"t":"كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ‏"},{"a":111,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ‏"},{"a":112,"t":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاࣰ مِّنَ اَ۬لصَّٰلِحِينَ"},{"a":113,"t":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَيٰ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنࣱ وَظَالِمࣱ لِّنَفْسِهِۦ مُبِينࣱۖ‏"},{"a":114,"t":"۞وَلَقَدْ مَنَنَّا عَلَيٰ مُوسَيٰ وَهَٰرُونَ"},{"a":115,"t":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ‏"},{"a":116,"t":"وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ‏"},{"a":117,"t":"وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ‏"},{"a":118,"t":"وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ‏"},{"a":119,"t":"وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لْأٓخِرِينَۖ‏"},{"a":120,"t":"سَلَٰمٌ عَلَيٰ مُوسَيٰ وَهَٰرُونَۖ‏"},{"a":121,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ‏"},{"a":122,"t":"إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ‏"},{"a":123,"t":"وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ"},{"a":124,"t":"إِذْ قَالَ لِقَوْمِهِۦ أَلَا تَتَّقُونَ"},{"a":125,"t":"أَتَدْعُونَ بَعْلاࣰ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ‏"},{"a":126,"t":"اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لْأَوَّلِينَۖ‏"},{"a":127,"t":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},{"a":128,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ‏"},{"a":129,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ‏"},{"a":130,"t":"سَلَٰمٌ عَلَيٰ ءَالِ يَاسِينَۖ‏"},{"a":131,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ‏"},{"a":132,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ‏"},{"a":133,"t":"وَإِنَّ لُوطاࣰ لَّمِنَ اَ۬لْمُرْسَلِينَ"},{"a":134,"t":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥ أَجْمَعِينَ"},{"a":135,"t":"إِلَّا عَجُوزاࣰ فِے اِ۬لْغَٰبِرِينَ"},{"a":136,"t":"ثُمَّ دَمَّرْنَا اَ۬لْأٓخَرِينَۖ‏"},{"a":137,"t":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},{"a":138,"t":"وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ‏"},{"a":139,"t":"وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ"},{"a":140,"t":"إِذْ أَبَقَ إِلَي اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ"},{"a":141,"t":"فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ"},{"a":142,"t":"فَالْتَقَمَهُ اُ۬لْحُوتُ وَهْوَ مُلِيمࣱۖ‏"},{"a":143,"t":"فَلَوْلَا أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ"},{"a":144,"t":"لَلَبِثَ فِے بَطْنِهِۦ إِلَيٰ يَوْمِ يُبْعَثُونَۖ‏"},{"a":145,"t":"۞فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهْوَ سَقِيمࣱۖ‏"},{"a":146,"t":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةࣰ مِّنْ يَّقْطِينࣲۖ‏"},{"a":147,"t":"وَأَرْسَلْنَٰهُ إِلَيٰ مِاْئَةِ أَلْفٍ أَوْ يَزِيدُونَۖ‏"},{"a":148,"t":"فَـَٔامَنُواْ فَمَتَّعْنَٰهُمْ إِلَيٰ حِينࣲۖ‏"},{"a":149,"t":"فَاسْتَفْتِهِمْ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ‏"},{"a":150,"t":"أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاࣰ وَهُمْ شَٰهِدُونَۖ‏"},{"a":151,"t":"أَلَا إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"},{"a":152,"t":"وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ‏"},{"a":153,"t":"أَصْطَفَي اَ۬لْبَنَاتِ عَلَي اَ۬لْبَنِينَۖ‏"},{"a":154,"t":"مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ‏"},{"a":155,"t":"أَفَلَا تَذَّكَّرُونَۖ‏"},{"a":156,"t":"أَمْ لَكُمْ سُلْطَٰنࣱ مُّبِينࣱ‏"},{"a":157,"t":"فَأْتُواْ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَۖ‏"},{"a":158,"t":"وَجَعَلُواْ بَيْنَهُۥ وَبَيْنَ اَ۬لْجِنَّةِ نَسَباࣰۖ وَلَقَدْ عَلِمَتِ اِ۬لْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَۖ‏"},{"a":159,"t":"سُبْحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَۖ‏"},{"a":160,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ‏"},{"a":161,"t":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"a":162,"t":"مَا أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ"},{"a":163,"t":"إِلَّا مَنْ هُوَ صَالِ اِ۬لْجَحِيمِۖ‏"},{"a":164,"t":"وَمَا مِنَّا إِلَّا لَهُۥ مَقَامࣱ مَّعْلُومࣱۖ‏"},{"a":165,"t":"وَإِنَّا لَنَحْنُ اُ۬لصَّآفُّونَ"},{"a":166,"t":"وَإِنَّا لَنَحْنُ اُ۬لْمُسَبِّحُونَۖ‏"},{"a":167,"t":"وَإِن كَانُواْ لَيَقُولُونَ"},{"a":168,"t":"لَوْ أَنَّ عِندَنَا ذِكْراࣰ مِّنَ اَ۬لْأَوَّلِينَ"},{"a":169,"t":"لَكُنَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ‏"},{"a":170,"t":"فَكَفَرُواْ بِهِۦۖ فَسَوْفَ يَعْلَمُونَۖ‏"},{"a":171,"t":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا اَ۬لْمُرْسَلِينَ"},{"a":172,"t":"إِنَّهُمْ لَهُمُ اُ۬لْمَنصُورُونَ"},{"a":173,"t":"وَإِنَّ جُندَنَا لَهُمُ اُ۬لْغَٰلِبُونَۖ‏"},{"a":174,"t":"فَتَوَلَّ عَنْهُمْ حَتَّيٰ حِينࣲۖ‏"},{"a":175,"t":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَۖ‏"},{"a":176,"t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ‏"},{"a":177,"t":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ اُ۬لْمُنذَرِينَۖ‏"},{"a":178,"t":"وَتَوَلَّ عَنْهُمْ حَتَّيٰ حِينࣲۖ‏"},{"a":179,"t":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَۖ‏"},{"a":180,"t":"سُبْحَٰنَ رَبِّكَ رَبِّ اِ۬لْعِزَّةِ عَمَّا يَصِفُونَۖ‏"},{"a":181,"t":"وَسَلَٰمٌ عَلَي اَ۬لْمُرْسَلِينَۖ‏"},{"a":182,"t":"وَالْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَۖ‏"}]}