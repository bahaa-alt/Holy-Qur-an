{"slug":"qaloon","n":86,"verses":[{"a":1,"t":"وَالسَّمَآءِ وَالطَّارِقِ"},{"a":2,"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لطَّارِقُ"},{"a":3,"t":"اُ۬لنَّجْمُ اُ۬لثَّاقِبُ"},{"a":4,"t":"إِن كُلُّ نَفْسࣲ لَّمَا عَلَيْهَا حَافِظࣱۖ‏"},{"a":5,"t":"فَلْيَنظُرِ اِ۬لْإِنسَٰنُ مِمَّ خُلِقَۖ‏"},{"a":6,"t":"خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏"},{"a":7,"t":"يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ‏"},{"a":8,"t":"إِنَّهُۥ عَلَيٰ رَجْعِهِۦ لَقَادِرࣱ‏"},{"a":9,"t":"يَوْمَ تُبْلَي اَ۬لسَّرَآئِرُ"},{"a":10,"t":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲۖ‏"},{"a":11,"t":"وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ"},{"a":12,"t":"وَالْأَرْضِ ذَاتِ اِ۬لصَّدْعِ"},{"a":13,"t":"إِنَّهُۥ لَقَوْلࣱ فَصْلࣱ‏"},{"a":14,"t":"وَمَا هُوَ بِالْهَزْلِۖ‏"},{"a":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْداࣰ‏"},{"a":16,"t":"وَأَكِيدُ كَيْداࣰۖ‏"},{"a":17,"t":"فَمَهِّلِ اِ۬لْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْداَۢۖ‏"}]}