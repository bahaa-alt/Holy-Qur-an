{"slug":"qaloon","n":96,"verses":[{"a":1,"t":"اِ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ‏"},{"a":2,"t":"خَلَقَ اَ۬لْإِنسَٰنَ مِنْ عَلَقٍۖ‏"},{"a":3,"t":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لْأَكْرَمُ"},{"a":4,"t":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ"},{"a":5,"t":"عَلَّمَ اَ۬لْإِنسَٰنَ مَا لَمْ يَعْلَمْۖ‏"},{"a":6,"t":"كَلَّا إِنَّ اَ۬لْإِنسَٰنَ لَيَطْغَيٰ"},{"a":7,"t":"أَن رَّءَاهُ اُ۪سْتَغْنَيٰۖ‏"},{"a":8,"t":"إِنَّ إِلَيٰ رَبِّكَ اَ۬لرُّجْعَيٰۖ‏"},{"a":9,"t":"أَرَٰ۬يْتَ اَ۬لذِے يَنْهَيٰ"},{"a":10,"t":"عَبْداً إِذَا صَلَّيٰۖ‏"},{"a":11,"t":"أَرَٰ۬يْتَ إِن كَانَ عَلَي اَ۬لْهُدَيٰ"},{"a":12,"t":"أَوْ أَمَرَ بِالتَّقْوَيٰ"},{"a":13,"t":"أَرَٰ۬يْتَ إِن كَذَّبَ وَتَوَلَّيٰ"},{"a":14,"t":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَرَيٰۖ‏"},{"a":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعاَۢ بِالنَّاصِيَةِ"},{"a":16,"t":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲۖ‏"},{"a":17,"t":"فَلْيَدْعُ نَادِيَهُۥ"},{"a":18,"t":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ‏"},{"a":19,"t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبۖ‏"}]}