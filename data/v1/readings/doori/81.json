{"slug":"doori","n":81,"verses":[{"a":1,"t":"إِذَا اَ۬لشَّمۡسُ كُوِّرَتۡ"},{"a":2,"t":"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتۡ"},{"a":3,"t":"وَإِذَا اَ۬لۡجِبَالُ سُيِّرَتۡ"},{"a":4,"t":"وَإِذَا اَ۬لۡعِشَارُ عُطِّلَتۡ"},{"a":5,"t":"وَإِذَا اَ۬لۡوُحُوشُ حُشِرَتۡ"},{"a":6,"t":"وَإِذَا اَ۬لۡبِحَارُ سُجِرَتۡ"},{"a":7,"t":"وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتۡ"},{"a":8,"t":"وَإِذَا اَ۬لۡمَوۡءُۥدَةُ سُئِلَتۡ"},{"a":9,"t":"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ"},{"a":10,"t":"وَإِذَا اَ۬لصُّحُفُ نُشِّرَتۡ"},{"a":11,"t":"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتۡ"},{"a":12,"t":"وَإِذَا اَ۬لۡجَحِيمُ سُعِرَتۡ"},{"a":13,"t":"وَإِذَا اَ۬لۡجَنَّةُ أُزۡلِفَتۡ"},{"a":14,"t":"عَلِمَتۡ نَفۡسࣱ مَّآ أَحۡضَرَتۡ"},{"a":15,"t":"فَلَآ أُقۡسِمُ بِالۡخُنَّسِ"},{"a":16,"t":"اِ۬لۡجَوَارِ اِ۬لۡكُنَّسِ"},{"a":17,"t":"وَاَلَّيۡلِ إِذَا عَسۡعَسَ"},{"a":18,"t":"وَاَلصُّبۡحِ إِذَا تَنَفَّسَ"},{"a":19,"t":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏"},{"a":20,"t":"ذِي قُوَّةٍ عِندَ ذِي اِ۬لۡعَرۡشِ مَكِينࣲ‏"},{"a":21,"t":"مُّطَاعࣲ ثَمَّ أَمِينࣲ‏"},{"a":22,"t":"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ‏"},{"a":23,"t":"وَلَقَدۡ رَء۪اهُ بِالۡأُفُقِ اِ۬لۡمُبِينِ"},{"a":24,"t":"وَمَا هُوَ عَلَى اَ۬لۡغَيۡبِ بِضظَنِينࣲ‏"},{"a":25,"t":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ‏"},{"a":26,"t":"فَأَيۡنَ تَذۡهَبُونَ"},{"a":27,"t":"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ"},{"a":28,"t":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ"},{"a":29,"t":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ اَ۬للَّهُ رَبُّ اُ۬لۡعَٰلَمِينَ"}]}