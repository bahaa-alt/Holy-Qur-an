{"slug":"doori","n":87,"verses":[{"a":1,"t":"سَبِّحِ اِ۪سۡمَ رَبِّكَ اَ۬لۡأَعۡلَى"},{"a":2,"t":"اَ۬لَّذِي خَلَقَ فَسَوّٜ يٰ"},{"a":3,"t":"وَاَلَّذِي قَدَّرَ فَهَدٜ يٰ"},{"a":4,"t":"وَاَلَّذِيٓ أَخۡرَجَ اَ۬لۡمَرۡعٜ يٰ"},{"a":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحۡوٜ يٰ"},{"a":6,"t":"سَنُقۡرِئُكَ فَلَا تَنسٜ يٰٓ"},{"a":7,"t":"إِلَّا مَا شَآءَ اَ۬للَّهُۚ إِنَّهُۥ يَعۡلَمُ اُ۬لۡجَهۡرَ وَمَا يَخۡفٜ يٰ"},{"a":8,"t":"وَنُيَسِّرُكَ لِلۡيُسۡر۪يٰ"},{"a":9,"t":"فَذَكِّرۡ إِن نَّفَعَتِ اِ۬لذِّكۡر۪يٰ"},{"a":10,"t":"سَيَذَّكَّرُ مَن يَخۡشٜ يٰ"},{"a":11,"t":"وَيَتَجَنَّبُهَا اَ۬لۡأَشۡقَى"},{"a":12,"t":"اَ۬لَّذِي يَصۡلَى اَ۬لنَّارَ اَ۬لۡكُبۡر۪يٰ"},{"a":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيٜ يٰ"},{"a":14,"t":"قَدۡ أَفۡلَحَ مَن تَزَكّٜ يٰ"},{"a":15,"t":"وَذَكَرَ اَ۪سۡمَ رَبِّهِۦ فَصَلّٜ يٰ"},{"a":16,"t":"بَلۡ يُؤۡثِرُونَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيٜ ا"},{"a":17,"t":"وَاَلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقٜ يٰٓ"},{"a":18,"t":"إِنَّ هَٰذَا لَفِي اِ۬لصُّحُفِ اِ۬لۡأُولٜ يٰ"},{"a":19,"t":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسٜ يٰ"}]}