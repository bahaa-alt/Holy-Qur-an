{"slug":"doori","n":56,"verses":[{"a":1,"t":"إِذَا وَقَعَتِ اِ۬لۡوَاقِعَةُ"},{"a":2,"t":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ"},{"a":3,"t":"خَافِضَةࣱ رَّافِعَةٌ"},{"a":4,"t":"إِذَا رُجَّتِ اِ۬لۡأَرۡضُ رَجࣰّ ا"},{"a":5,"t":"وَبُسَّتِ اِ۬لۡجِبَالُ بَسࣰّ ا"},{"a":6,"t":"فَكَانَتۡ هَبَآءࣰ مُّنۢبَثࣰّ ا"},{"a":7,"t":"وَكُنتُمۡ أَزۡوَٰجࣰ ا ثَلَٰثَةࣰ‏"},{"a":8,"t":"فَأَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ"},{"a":9,"t":"وَأَصۡحَٰبُ اُ۬لۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ اُ۬لۡمَشۡـَٔمَةِ"},{"a":10,"t":"وَاَلسَّٰبِقُونَ اَ۬لسَّٰبِقُونَ"},{"a":11,"t":"أُوْلَٰٓئِكَ اَ۬لۡمُقَرَّبُونَ"},{"a":12,"t":"فِي جَنَّٰتِ اِ۬لنَّعِيمِ"},{"a":13,"t":"ثُلَّةࣱ مِّنَ اَ۬لۡأَوَّلِينَ"},{"a":14,"t":"وَقَلِيلࣱ مِّنَ اَ۬لۡأٓخِرِينَ"},{"a":15,"t":"عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ‏"},{"a":16,"t":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ"},{"a":17,"t":"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنࣱ مُّخَلَّدُونَ"},{"a":18,"t":"بِأَكۡوَابࣲ وَأَبَارِيقَ وَكَأۡسࣲ مِّن مَّعِينࣲ‏"},{"a":19,"t":"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ"},{"a":20,"t":"وَفَٰكِهَةࣲ مِّمَّا يَتَخَيَّرُونَ"},{"a":21,"t":"وَلَحۡمِ طَيۡرࣲ مِّمَّا يَشۡتَهُونَ"},{"a":22,"t":"وَحُورٌ عِينࣱ‏"},{"a":23,"t":"كَأَمۡثَٰلِ اِ۬للُّؤۡلُوِٕ اِ۬لۡمَكۡنُونِ"},{"a":24,"t":"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ"},{"a":25,"t":"لَا يَسۡمَعُونَ فِيهَا لَغۡوࣰ ا وَلَا تَأۡثِيمًا"},{"a":26,"t":"إِلَّا قِيلࣰ ا سَلَٰمࣰ ا سَلَٰمࣰ ا"},{"a":27,"t":"وَأَصۡحَٰبُ اُ۬لۡيَمِينِ مَآ أَصۡحَٰبُ اُ۬لۡيَمِينِ"},{"a":28,"t":"فِي سِدۡرࣲ مَّخۡضُودࣲ‏"},{"a":29,"t":"وَطَلۡحࣲ مَّنضُودࣲ‏"},{"a":30,"t":"وَظِلࣲّ مَّمۡدُودࣲ‏"},{"a":31,"t":"وَمَآءࣲ مَّسۡكُوبࣲ‏"},{"a":32,"t":"وَفَٰكِهَةࣲ كَثِيرَةࣲ‏"},{"a":33,"t":"لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ‏"},{"a":34,"t":"وَفُرُشࣲ مَّرۡفُوعَةٍ"},{"a":35,"t":"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءࣰ‏"},{"a":36,"t":"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا"},{"a":37,"t":"عُرُبًا أَتۡرَابࣰ ا"},{"a":38,"t":"لِّأَصۡحَٰبِ اِ۬لۡيَمِينِ"},{"a":39,"t":"۞ثُلَّةࣱ مِّنَ اَ۬لۡأَوَّلِينَ"},{"a":40,"t":"وَثُلَّةࣱ مِّنَ اَ۬لۡأٓخِرِينَ"},{"a":41,"t":"وَأَصۡحَٰبُ اُ۬لشِّمَالِ مَآ أَصۡحَٰبُ اُ۬لشِّمَالِ"},{"a":42,"t":"فِي سَمُومࣲ وَحَمِيمࣲ‏"},{"a":43,"t":"وَظِلࣲّ مِّن يَحۡمُومࣲ‏"},{"a":44,"t":"لَّا بَارِدࣲ وَلَا كَرِيمٍ"},{"a":45,"t":"إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ"},{"a":46,"t":"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لۡحِنثِ اِ۬لۡعَظِيمِ"},{"a":47,"t":"وَكَانُواْ يَقُولُونَ أَٰى۪ذَا مُتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَٰ۟نَّا لَمَبۡعُوثُونَ"},{"a":48,"t":"أَوَءَابَآؤُنَا اَ۬لۡأَوَّلُونَ"},{"a":49,"t":"قُلۡ إِنَّ اَ۬لۡأَوَّلِينَ وَاَلۡأٓخِرِينَ"},{"a":50,"t":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمࣲ مَّعۡلُومࣲ‏"},{"a":51,"t":"ثُمَّ إِنَّكُمۡ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لۡمُكَذِّبُونَ"},{"a":52,"t":"لَأٓكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ‏"},{"a":53,"t":"فَمَالِـُٔونَ مِنۡهَا اَ۬لۡبُطُونَ"},{"a":54,"t":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ اَ۬لۡحَمِيمِ"},{"a":55,"t":"فَشَٰرِبُونَ شَرۡبَ اَ۬لۡهِيمِ"},{"a":56,"t":"هَٰذَا نُزُلُهُمۡ يَوۡمَ اَ۬لدِّينِ"},{"a":57,"t":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ"},{"a":58,"t":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ"},{"a":59,"t":"ءَٰا۬نتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ اُ۬لۡخَٰلِقُونَ"},{"a":60,"t":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ اُ۬لۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ"},{"a":61,"t":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ"},{"a":62,"t":"وَلَقَدۡ عَلِمۡتُمُ اُ۬لنَّشَآءَةَ اَ۬لۡأُولٜ يٰ فَلَوۡلَا تَذَّكَّرُونَ"},{"a":63,"t":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ"},{"a":64,"t":"ءَٰا۬نتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ اُ۬لزَّٰرِعُونَ"},{"a":65,"t":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمࣰ ا فَظَلۡتُمۡ تَفَكَّهُونَ"},{"a":66,"t":"إِنَّا لَمُغۡرَمُونَ"},{"a":67,"t":"بَلۡ نَحۡنُ مَحۡرُومُونَ"},{"a":68,"t":"أَفَرَءَيۡتُمُ اُ۬لۡمَآءَ اَ۬لَّذِي تَشۡرَبُونَ"},{"a":69,"t":"ءَٰا۬نتُمۡ أَنزَلۡتُمُوهُ مِنَ اَ۬لۡمُزۡنِ أَمۡ نَحۡنُ اُ۬لۡمُنزِلُونَ"},{"a":70,"t":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجࣰ ا فَلَوۡلَا تَشۡكُرُونَ"},{"a":71,"t":"أَفَرَءَيۡتُمُ اُ۬لنَّارَ اَ۬لَّتِي تُورُونَ"},{"a":72,"t":"ءَٰا۬نتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ اُ۬لۡمُنشِـُٔونَ"},{"a":73,"t":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةࣰ وَمَتَٰعࣰ ا لِّلۡمُقۡوِينَ"},{"a":74,"t":"فَسَبِّحۡ بِاسۡمِ رَبِّكَ اَ۬لۡعَظِيمِ"},{"a":75,"t":"۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ"},{"a":76,"t":"وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِيمٌ"},{"a":77,"t":"إِنَّهُۥ لَقُرۡءَانࣱ كَرِيمࣱ‏"},{"a":78,"t":"فِي كِتَٰبࣲ مَّكۡنُونࣲ‏"},{"a":79,"t":"لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لۡمُطَهَّرُونَ"},{"a":80,"t":"تَنزِيلࣱ مِّن رَّبِّ اِ۬لۡعَٰلَمِينَ"},{"a":81,"t":"أَفَبِهَٰذَا اَ۬لۡحَدِيثِ أَنتُم مُّدۡهِنُونَ"},{"a":82,"t":"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ"},{"a":83,"t":"فَلَوۡلَآ إِذَا بَلَغَتِ اِ۬لۡحُلۡقُومَ"},{"a":84,"t":"وَأَنتُمۡ حِينَئِذࣲ تَنظُرُونَ"},{"a":85,"t":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ"},{"a":86,"t":"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ"},{"a":87,"t":"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ"},{"a":88,"t":"فَأَمَّآ إِن كَانَ مِنَ اَ۬لۡمُقَرَّبِينَ"},{"a":89,"t":"فَرَوۡحࣱ وَرَيۡحَانࣱ وَجَنَّتُ نَعِيمࣲ‏"},{"a":90,"t":"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ اِ۬لۡيَمِينِ"},{"a":91,"t":"فَسَلَٰمࣱ لَّكَ مِنۡ أَصۡحَٰبِ اِ۬لۡيَمِينِ"},{"a":92,"t":"وَأَمَّآ إِن كَانَ مِنَ اَ۬لۡمُكَذِّبِينَ اَ۬لضَّآلِّينَ"},{"a":93,"t":"فَنُزُلࣱ مِّنۡ حَمِيمࣲ‏"},{"a":94,"t":"وَتَصۡلِيَةُ جَحِيمٍ"},{"a":95,"t":"إِنَّ هَٰذَا لَهۡوَ حَقُّ اُ۬لۡيَقِينِ"},{"a":96,"t":"فَسَبِّحۡ بِاسۡمِ رَبِّكَ اَ۬لۡعَظِيمِ"}]}