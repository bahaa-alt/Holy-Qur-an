{"slug":"doori","n":82,"verses":[{"a":1,"t":"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتۡ"},{"a":2,"t":"وَإِذَا اَ۬لۡكَوَاكِبُ اُ۪نتَثَرَتۡ"},{"a":3,"t":"وَإِذَا اَ۬لۡبِحَارُ فُجِّرَتۡ"},{"a":4,"t":"وَإِذَا اَ۬لۡقُبُورُ بُعۡثِرَتۡ"},{"a":5,"t":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ"},{"a":6,"t":"يَٰٓأَيُّهَا اَ۬لۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لۡكَرِيمِ"},{"a":7,"t":"اِ۬لَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ"},{"a":8,"t":"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ"},{"a":9,"t":"كَلَّا بَلۡ تُكَذِّبُونَ بِالدِّينِ"},{"a":10,"t":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ"},{"a":11,"t":"كِرَامࣰ ا كَٰتِبِينَ"},{"a":12,"t":"يَعۡلَمُونَ مَا تَفۡعَلُونَ"},{"a":13,"t":"إِنَّ اَ۬لۡأَبۡرَارَ لَفِي نَعِيمࣲ‏"},{"a":14,"t":"وَإِنَّ اَ۬لۡفُجَّارَ لَفِي جَحِيمࣲ‏"},{"a":15,"t":"يَصۡلَوۡنَهَا يَوۡمَ اَ۬لدِّينِ"},{"a":16,"t":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ"},{"a":17,"t":"وَمَآ أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لدِّينِ"},{"a":18,"t":"ثُمَّ مَآ أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لدِّينِ"},{"a":19,"t":"يَوۡمُ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔ اۖ وَاَلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ"}]}