{"slug":"doori","n":77,"verses":[{"a":1,"t":"وَاَلۡمُرۡسَلَٰتِ عُرۡفࣰ ا"},{"a":2,"t":"فَاَلۡعَٰصِفَٰتِ عَصۡفࣰ ا"},{"a":3,"t":"وَاَلنَّٰشِرَٰتِ نَشۡرࣰ ا"},{"a":4,"t":"فَاَلۡفَٰرِقَٰتِ فَرۡقࣰ ا"},{"a":5,"t":"فَاَلۡمُلۡقِيَٰتِ ذِكۡرًا"},{"a":6,"t":"عُذۡرًا أَوۡ نُذۡرًا"},{"a":7,"t":"إِنَّمَا تُوعَدُونَ لَوَٰقِعࣱ‏"},{"a":8,"t":"فَإِذَا اَ۬لنُّجُومُ طُمِسَتۡ"},{"a":9,"t":"وَإِذَا اَ۬لسَّمَآءُ فُرِجَتۡ"},{"a":10,"t":"وَإِذَا اَ۬لۡجِبَالُ نُسِفَتۡ"},{"a":11,"t":"وَإِذَا اَ۬لرُّسُلُ اۥُقِّتَتۡ"},{"a":12,"t":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ"},{"a":13,"t":"لِيَوۡمِ اِ۬لۡفَصۡلِ"},{"a":14,"t":"وَمَآ أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لۡفَصۡلِ"},{"a":15,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":16,"t":"۞أَلَمۡ نُهۡلِكِ اِ۬لۡأَوَّلِينَ"},{"a":17,"t":"ثُمَّ نُتۡبِعُهُمُ اُ۬لۡأٓخِرِينَ"},{"a":18,"t":"كَذَٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِينَ"},{"a":19,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":20,"t":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءࣲ مَّهِينࣲ‏"},{"a":21,"t":"فَجَعَلۡنَٰهُ فِي قَر۪ارࣲ مَّكِينٍ"},{"a":22,"t":"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ‏"},{"a":23,"t":"فَقَدَرۡنَا فَنِعۡمَ اَ۬لۡقَٰدِرُونَ"},{"a":24,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":25,"t":"أَلَمۡ نَجۡعَلِ اِ۬لۡأَرۡضَ كِفَاتًا"},{"a":26,"t":"أَحۡيَآءࣰ وَأَمۡوَٰتࣰ ا"},{"a":27,"t":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسۡقَيۡنَٰكُم مَّآءࣰ فُرَاتࣰ ا"},{"a":28,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":29,"t":"اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"a":30,"t":"اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلࣲّ ذِي ثَلَٰثِ شُعَبࣲ‏"},{"a":31,"t":"لَّا ظَلِيلࣲ وَلَا يُغۡنِي مِنَ اَ۬للَّهَبِ"},{"a":32,"t":"إِنَّهَا تَرۡمِي بِشَرَرࣲ كَاَلۡقَصۡرِ"},{"a":33,"t":"كَأَنَّهُۥ جِمَٰلَٰتࣱ صُفۡرࣱ‏"},{"a":34,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":35,"t":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ"},{"a":36,"t":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ"},{"a":37,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":38,"t":"هَٰذَا يَوۡمُ اُ۬لۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَاَلۡأَوَّلِينَ"},{"a":39,"t":"فَإِن كَانَ لَكُمۡ كَيۡدࣱ فَكِيدُونِ"},{"a":40,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":41,"t":"إِنَّ اَ۬لۡمُتَّقِينَ فِي ظِلَٰلࣲ وَعُيُونࣲ‏"},{"a":42,"t":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ"},{"a":43,"t":"كُلُواْ وَاَشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ"},{"a":44,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي اِ۬لۡمُحۡسِنِينَ"},{"a":45,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":46,"t":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ"},{"a":47,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":48,"t":"وَإِذَا قِيلَ لَهُمُ اُ۪رۡكَعُواْ لَا يَرۡكَعُونَ"},{"a":49,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"a":50,"t":"فَبِأَيِّ حَدِيثِۢ بَعۡدَهُۥ يُؤۡمِنُونَ"}]}