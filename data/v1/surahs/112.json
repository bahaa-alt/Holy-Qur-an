{"n":112,"verses":[{"a":1,"w":["قُلۡ","هُوَ","ٱللَّهُ","أَحَدٌ"],"t":"Say, \"He is Allah, [who is] One"},{"a":2,"w":["ٱللَّهُ","ٱلصَّمَدُ"],"t":"Allah, the Eternal Refuge"},{"a":3,"w":["لَمۡ","يَلِدۡ","وَلَمۡ","يُولَدۡ"],"t":"He neither begets nor is born"},{"a":4,"w":["وَلَمۡ","يَكُن","لَّهُۥ","كُفُوًا","أَحَدُۢ"],"t":"Nor is there to Him any equivalent"}]}