{"n":96,"verses":[{"a":1,"w":["ٱقۡرَأۡ","بِٱسۡمِ","رَبِّكَ","ٱلَّذِي","خَلَقَ"],"t":"Recite in the name of your Lord who created"},{"a":2,"w":["خَلَقَ","ٱلۡإِنسَٰنَ","مِنۡ","عَلَقٍ"],"t":"Created man from a clinging substance"},{"a":3,"w":["ٱقۡرَأۡ","وَرَبُّكَ","ٱلۡأَكۡرَمُ"],"t":"Recite, and your Lord is the most Generous"},{"a":4,"w":["ٱلَّذِي","عَلَّمَ","بِٱلۡقَلَمِ"],"t":"Who taught by the pen"},{"a":5,"w":["عَلَّمَ","ٱلۡإِنسَٰنَ","مَا","لَمۡ","يَعۡلَمۡ"],"t":"Taught man that which he knew not"},{"a":6,"w":["كَلَّآ","إِنَّ","ٱلۡإِنسَٰنَ","لَيَطۡغَىٰٓ"],"t":"No! [But] indeed, man transgresses"},{"a":7,"w":["أَن","رَّءَاهُ","ٱسۡتَغۡنَىٰٓ"],"t":"Because he sees himself self-sufficient"},{"a":8,"w":["إِنَّ","إِلَىٰ","رَبِّكَ","ٱلرُّجۡعَىٰٓ"],"t":"Indeed, to your Lord is the return"},{"a":9,"w":["أَرَءَيۡتَ","ٱلَّذِي","يَنۡهَىٰ"],"t":"Have you seen the one who forbids"},{"a":10,"w":["عَبۡدًا","إِذَا","صَلَّىٰٓ"],"t":"A servant when he prays"},{"a":11,"w":["أَرَءَيۡتَ","إِن","كَانَ","عَلَى","ٱلۡهُدَىٰٓ"],"t":"Have you seen if he is upon guidance"},{"a":12,"w":["أَوۡ","أَمَرَ","بِٱلتَّقۡوَىٰٓ"],"t":"Or enjoins righteousness"},{"a":13,"w":["أَرَءَيۡتَ","إِن","كَذَّبَ","وَتَوَلَّىٰٓ"],"t":"Have you seen if he denies and turns away"},{"a":14,"w":["أَلَمۡ","يَعۡلَم","بِأَنَّ","ٱللَّهَ","يَرَىٰ"],"t":"Does he not know that Allah sees"},{"a":15,"w":["كَلَّا","لَئِن","لَّمۡ","يَنتَهِ","لَنَسۡفَعَۢا","بِٱلنَّاصِيَةِ"],"t":"No! If he does not desist, We will surely drag him by the forelock"},{"a":16,"w":["نَاصِيَةٖ","كَٰذِبَةٍ","خَاطِئَةٖ"],"t":"A lying, sinning forelock"},{"a":17,"w":["فَلۡيَدۡعُ","نَادِيَهُۥ"],"t":"Then let him call his associates"},{"a":18,"w":["سَنَدۡعُ","ٱلزَّبَانِيَةَ"],"t":"We will call the angels of Hell"},{"a":19,"w":["كَلَّا","لَا","تُطِعۡهُ","وَٱسۡجُدۡۤ","وَٱقۡتَرِب۩"],"t":"No! Do not obey him. But prostrate and draw near [to Allah]"}]}